<?xml version="1.0"?>
<!--
  Pista livre para ajustar movimentação: chão plano, sem obstáculo.

  De propósito sem paredes nem objetos — o que estamos caçando aqui é o
  comportamento do próprio robô (zigue-zague, curva que não fecha, traseira
  saindo), não desvio de obstáculo. Parede só atrapalharia, encurtando as
  trajetórias antes de o erro se manifestar.

  Marcações de 1 m no chão servem de referência visual para ver o S a olho nu.
-->
<sdf version="1.10">
  <world name="pista_livre">

    <physics name="passo_fino" type="ode">
      <!-- Passo pequeno: o contato da roda boba com o chão e o pivô girando
           são rápidos; passo grosso amortece justamente a dinâmica que
           queremos observar. -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface>
            <friction>
              <ode>
                <!-- Piso interno liso. O atrito efetivo do contato sai da
                     combinação com o mu de cada roda (ver robo2.gazebo.xacro),
                     que é onde a assimetria motriz/boba está declarada. -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.42 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
