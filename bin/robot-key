#!/usr/bin/env bash
# Teleop por teclado (WASD) publicando na entrada do twist_mux (key_vel, prio 90).
# PLANO_HEADLESS_2026-05-22 §4.4. Instalado em /usr/local/bin pelo setup_pi.sh.
#
# Rode num terminal SSH/tmux separado. O twist_mux arbitra: o PS4 (joy_vel,
# prio 100) vence o teclado; o teclado vence o Nav2/trekking (nav_vel, prio 10).
#
# Uso:  robot-key
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$REPO_DIR"

# SSH não-interativo não lê o ~/.bashrc → ROS pode não estar sourceado.
# Tenta o workspace primeiro; senão cai pra distro base (/opt/ros/*/setup.bash).
#
# ⚠️ `set -u` FICA SUSPENSO aqui, e não é frescura: os setup.bash do colcon e do
# ament leem variáveis sem default (`COLCON_TRACE`, `AMENT_TRACE_SETUP_FILES`, e
# não são só essas). Com `-u` ligado o script morre na primeira delas, ANTES de
# o teleop existir. Em 06-08 isso impediu o teste do homem-morto de rodar:
#
#     install/setup.bash: line 11: COLCON_TRACE: unbound variable
#     /opt/ros/jazzy/local_setup.bash: line 8: AMENT_TRACE_SETUP_FILES: unbound
#
# Definir cada variável na mão seria correr atrás de uma lista que é do
# upstream. Suspender o `-u` só no trecho do source é o escopo certo — ele volta
# logo abaixo, e o `command -v ros2` continua sendo quem decide se deu certo.
set +u
if [ -f install/setup.bash ]; then
    # shellcheck disable=SC1091
    source install/setup.bash
else
    for d in /opt/ros/*/setup.bash; do
        # shellcheck disable=SC1090
        [ -f "$d" ] && source "$d" && break
    done
fi
set -u

if ! command -v ros2 >/dev/null 2>&1; then
    echo "ERRO: 'ros2' não encontrado. Source /opt/ros/<distro>/setup.bash ou rode ./start.sh pra compilar o workspace." >&2
    exit 1
fi

# Teleop PROPRIO do robo 2 (05-08): o teleop_twist_keyboard de fabrica publica
# Twist cru e a cadeia deste robo e TwistStamped inteira — o DDS rejeitaria por
# type hash e o mux publicaria no vazio. E o nosso e homem-morto: soltou o
# teclado, o robo para.
exec ros2 run robot_motion teleop_teclado \
    --ros-args -r /teleop_teclado/cmd_vel:=/key_vel
