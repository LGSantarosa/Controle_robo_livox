#!/usr/bin/env bash
# Validação final da etapa 4 — passo 7 (docs/PLANO_ETAPA4_ROBO3.md §10).
# Roteiro: docs/ROTEIRO_PASSO7_ETAPA4.md. Um cenário por chamada:
#
#   bash bin/valida-etapa4 robo2-gazebo X Y     pilha do robô 2 no Gazebo + corrida até (X, Y)
#   bash bin/valida-etapa4 robo3-gazebo         sim_robo3 + smoke 6/6
#   bash bin/valida-etapa4 mega-fingida         sobe-robo3 contra a MEGA fingida (pty)
#
# Cada chamada cria ~/validacao_etapa4/<data>_<cenario>/ NOVA (nunca escreve
# nas baselines de docs/dados) e grava: git.txt, ambiente.txt, comandos.txt,
# console.txt, os logs de cada processo, grupos_wrapper.txt (PGID/STARTTIME de
# tudo o que ESTE script subiu), as capturas, resultado.txt (um item por
# linha, APROVADO/REPROVADO) e limpeza.txt. Reprovação não apaga nada.
#
# Isolamento: cada cenário num ROS_DOMAIN_ID próprio, só localhost; todo
# processo que ele cria herda VALIDA_ETAPA4_MARCA=<pasta>. Limpeza: só os
# grupos que ele registrou (INT, 20 s, KILL), depois quem ainda tiver a marca
# DESTA pasta; a prova é zero processo marcado e `ros2 node list` vazio nos
# domínios usados. NUNCA mata por nome.
#
# Recusa, sem matar nada: árvore suja, qualquer ROS/Gazebo já de pé no PC,
# processo marcado de rodada anterior, e (mega-fingida) joystick conectado ou
# registro do sobe-robo3 existente.
set +u
R="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CENARIO="$1"; shift
case "$CENARIO" in
  robo2-gazebo) DOMINIO=41
    ALVO_X="$1"; ALVO_Y="$2"
    [[ "$ALVO_X" =~ ^-?[0-9]+([.][0-9]+)?$ && "$ALVO_Y" =~ ^-?[0-9]+([.][0-9]+)?$ ]] \
      || { echo "uso: bash bin/valida-etapa4 robo2-gazebo X Y"; exit 2; } ;;
  robo3-gazebo) DOMINIO=42 ;;
  mega-fingida) DOMINIO=43; DOMINIO_EXT=44 ;;
  *) echo "uso: bash bin/valida-etapa4 robo2-gazebo X Y | robo3-gazebo | mega-fingida"; exit 2 ;;
esac

CARIMBO="$(date +%Y%m%d_%H%M%S)"
SAIDA="$HOME/validacao_etapa4/${CARIMBO}_${CENARIO}"
[ -e "$SAIDA" ] && { echo "🔴 $SAIDA já existe — não reaproveito pasta"; exit 1; }
mkdir -p "$SAIDA" || exit 1
exec > >(tee -a "$SAIDA/console.txt") 2>&1
GRUPOS="$SAIDA/grupos_wrapper.txt"; : > "$GRUPOS"
RESULTADO="$SAIDA/resultado.txt"; : > "$RESULTADO"
V="$R/tools/valida_etapa4"
export ROS_DOMAIN_ID="$DOMINIO"
export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
# O transporte do Gazebo não olha o ROS_DOMAIN_ID: partição própria por rodada.
export GZ_PARTITION="valida_etapa4_$CARIMBO"
DOMINIOS_USADOS="$DOMINIO ${DOMINIO_EXT:-}"

# anota, roda, stat_de, sobe_grupo, nos_do_dominio, limpa, instala_limpeza
source "$V/lib.sh"

# ── pré-condições (antes de subir QUALQUER coisa) ─────────────────────────────

echo "== validação etapa 4 · $CENARIO · $CARIMBO =="
echo "   pasta: $SAIDA · ROS_DOMAIN_ID=$DOMINIOS_USADOS · só localhost · GZ_PARTITION=$GZ_PARTITION"
{ echo "commit: $(git -C "$R" rev-parse HEAD)"; git -C "$R" log -1 --format='%h %ad %s' --date=iso
  echo "branch: $(git -C "$R" rev-parse --abbrev-ref HEAD)"
  echo "status --porcelain (vazio = limpo):"; git -C "$R" status --porcelain; } > "$SAIDA/git.txt"
if [ -n "$(git -C "$R" status --porcelain)" ]; then
  echo "   🔴 árvore com mudança não commitada — a proveniência seria falsa:"
  git -C "$R" status --porcelain | sed 's/^/      /'; exit 1
fi
PRE="$(ps -eo pid,user,args | grep -E '(^|[ /])(ros2|gz|rviz2|_ros2_daemon)( |$)|/opt/ros/[a-z]+/lib/|/install/[a-z_]+/lib/|ros2cli\.daemon' | grep -vE 'grep -E|valida-etapa4')"
if [ -n "$PRE" ]; then
  echo "   🔴 já tem ROS/Gazebo de pé neste PC — não subo por cima nem mato nada:"
  echo "$PRE" | sed 's/^/      /'; exit 1
fi
if grep -lsa "VALIDA_ETAPA4_MARCA=" /proc/[0-9]*/environ 2>/dev/null | grep -q .; then
  echo "   🔴 há processo marcado de uma rodada anterior:"
  grep -lsa "VALIDA_ETAPA4_MARCA=" /proc/[0-9]*/environ | sed 's|/environ||;s|^|      |'; exit 1
fi
if [ "$CENARIO" = mega-fingida ]; then
  if ls /dev/input/js* >/dev/null 2>&1; then
    echo "   🔴 joystick conectado ($(ls /dev/input/js* | tr '\n' ' ')): o joy_node real o leria"
    echo "      e misturaria com o /joy fingido. Desconecte e rode de novo."; exit 1
  fi
  if [ -e "$HOME/.local/state/sobe-robo3/grupos" ]; then
    echo "   🔴 existe registro do sobe-robo3 — confira com: bash bin/sobe-robo3 --mata"; exit 1
  fi
fi

# A marca entra SÓ agora, depois das pré-condições: antes disso o próprio
# grep que procura marca de rodada anterior a teria (e se acharia). Daqui em
# diante todo processo lançado a herda; o wrapper em si e o `tee` do console,
# não (o environ de um processo é o do exec dele).
export VALIDA_ETAPA4_MARCA="$SAIDA"
# Daqui em diante TODA saída (build falhou, install difere, Ctrl+C, fim
# normal) passa pela limpeza — idempotente.
instala_limpeza

cd "$R" || exit 1
source /opt/ros/jazzy/setup.bash

echo "== compilando robot_base robot_motion robot_nav (build.log) =="
if ! roda "$SAIDA/build.log" colcon build --packages-select robot_base robot_motion robot_nav; then
  anota "build" REPROVADO; exit 1
fi
source install/setup.bash
DIF=0
while read -r pkg padrao destino; do
  while IFS= read -r f; do
    cmp -s "$f" "install/$pkg/share/$pkg/$destino/$(basename "$f")" \
      || { echo "   🔴 install/ difere do fonte: $f"; DIF=1; }
  done < <(git ls-files "$padrao")
done <<'EOF_LISTA'
robot_base   ros2_packages/robot_base/package.xml            .
robot_base   ros2_packages/robot_base/launch/*.py            launch
robot_base   ros2_packages/robot_base/config/*               config
robot_base   ros2_packages/robot_base/description/*.xacro    description
robot_base   worlds/*.sdf                                    worlds
robot_motion ros2_packages/robot_motion/package.xml          .
robot_motion ros2_packages/robot_motion/config/*.yaml        config
robot_motion ros2_packages/robot_motion/launch/*.py          launch
robot_motion ros2_packages/robot_motion/rviz/*.rviz          rviz
robot_motion ros2_packages/robot_motion/behavior_trees/*.xml behavior_trees
robot_nav    ros2_packages/robot_nav/package.xml             .
robot_nav    ros2_packages/robot_nav/launch/*.py             launch
robot_nav    ros2_packages/robot_nav/urdf/*                  urdf
robot_nav    ros2_packages/robot_nav/config/*                config
robot_nav    ros2_packages/robot_nav/behavior_trees/*.xml    behavior_trees
EOF_LISTA
[ "$DIF" -ne 0 ] && { anota "install/ igual ao fonte" REPROVADO; exit 1; }
anota "build + install/ igual ao fonte" APROVADO

{ date -Is; uname -a; echo "hostname: $(hostname)"
  echo "ROS_DISTRO=$ROS_DISTRO"; ros2 --help >/dev/null 2>&1 && echo "ros2 no PATH: $(command -v ros2)"
  printenv | grep -E '^(ROS|RMW|AMENT|COLCON|GZ|IGN|FASTRTPS|CYCLONEDDS|PYTHONPATH|VALIDA)' | sort
  echo "--- /dev/input/js*:"; ls /dev/input/js* 2>&1
  echo "--- nota: as baselines do robô 2 foram capturadas no ROS_DOMAIN_ID 0; esta"
  echo "    rodada usa $DOMINIOS_USADOS por isolamento. O domínio não entra nos"
  echo "    parâmetros comparados e NÃO é uma permissão de diferença."
} > "$SAIDA/ambiente.txt"

# Lista completa de nós + uniq -d + comparação com a esperada.
confere_nos() {   # confere_nos <esperados.yaml> <dominio> <prefixo>
  if ! nos_do_dominio "$2" "$SAIDA/$3_nos.txt"; then
    anota "$3: lista de nós = esperada, uniq -d vazio" REPROVADO "(ros2 node list falhou: $3_nos.txt.err)"
    return 1
  fi
  sort "$SAIDA/$3_nos.txt" | uniq -d > "$SAIDA/$3_uniq_d.txt"
  if roda "$SAIDA/$3_lista_nos.log" python3 "$V/lista_nos.py" "$1" "$SAIDA/$3_nos.txt" \
       "$SAIDA/$3_lista_nos.yaml"; then
    anota "$3: lista de nós = esperada, uniq -d vazio" APROVADO
  else
    anota "$3: lista de nós = esperada, uniq -d vazio" REPROVADO "($3_lista_nos.yaml)"
  fi
}
captura() {       # captura <esperados.yaml> <pasta> <prazo> — prontidão explícita + dumps
  if roda "$2.log" python3 tools/linha_de_base/captura.py "$1" "$2" --prazo "$3"; then
    anota "$(basename "$2"): grafo pronto e estável, dumps" APROVADO
  else
    anota "$(basename "$2"): grafo pronto e estável, dumps" REPROVADO "($(basename "$2")/resumo.yaml)"
  fi
}
erros_do_launch() {
  grep -nE "\[ERROR\]|\[FATAL\]|process has died" "$1" > "$2"
  anota "linhas ERROR/FATAL/died em $(basename "$1")" ANOTADO "$(wc -l < "$2") ($(basename "$2"))"
}

# ── cenários ──────────────────────────────────────────────────────────────────

robo2_gazebo() {
  echo "== robô 2: pilha no Gazebo (comando do §8, sem outro argumento) =="
  sobe_grupo pilha "$SAIDA/launch.log" ros2 launch robot_motion pilha.launch.py sim:=true || return
  captura tools/linha_de_base/esperados_robo2_sim.yaml "$SAIDA/captura" 240
  confere_nos tools/linha_de_base/esperados_robo2_sim.yaml "$DOMINIO" robo2
  echo "== parâmetros contra a v2 (sem permissão) e a original (permissão do passo 2) =="
  if roda "$SAIDA/comparacao.log" python3 "$V/compara_robo2.py" \
       "$SAIDA/captura/parametros_normalizados.yaml" "$SAIDA/comparacao.yaml"; then
    anota "parâmetros: v2 sem permissão, original com passo 2, padding" APROVADO
  else
    anota "parâmetros: v2 sem permissão, original com passo 2, padding" REPROVADO "(comparacao.yaml)"
  fi
  echo "== corrida até ($ALVO_X, $ALVO_Y) — smoke, não medida =="
  # teto 120 s: o próprio instrumento cancela o objetivo; o timeout de 180 s é
  # só a rede, se ele travar.
  roda "$SAIDA/corrida.txt" timeout -s INT 180 python3 tools/banco/corrida_nav.py \
       --alvo "$ALVO_X" "$ALVO_Y" --csv "$SAIDA/corrida.csv" --teto-s 120
  grep -q '^🟢 chegada' "$SAIDA/corrida.txt" \
    && anota "corrida da pista chegou" APROVADO \
    || anota "corrida da pista chegou" REPROVADO "(corrida.txt)"
  erros_do_launch "$SAIDA/launch.log" "$SAIDA/erros_launch.txt"
}

robo3_gazebo() {
  echo "== robô 3: sim_robo3 na pista (argumentos do smoke-gazebo-robo3) =="
  sobe_grupo sim_robo3 "$SAIDA/launch.log" ros2 launch robot_base sim_robo3.launch.py \
      mundo:="$R/worlds/pista_obstaculos.sdf" x:=2.0 y:=5.0 yaw:=0.0 gui:=true || return
  captura "$V/esperados_robo3_sim.yaml" "$SAIDA/captura" 180
  confere_nos "$V/esperados_robo3_sim.yaml" "$DOMINIO" robo3
  echo "== smoke (6 itens) =="
  mkdir -p "$SAIDA/smoke"
  if roda "$SAIDA/smoke.log" python3 tools/smoke_gazebo_robo3.py "$SAIDA/smoke" 10; then
    anota "smoke-gazebo-robo3 6/6" APROVADO
  else
    anota "smoke-gazebo-robo3 6/6" REPROVADO "(smoke/resultado.csv)"
  fi
  erros_do_launch "$SAIDA/launch.log" "$SAIDA/erros_launch.txt"
}

tem_os_4() {   # os 4 externos, exatamente uma vez cada
  [ "$(grep -cxE '/(joy_node|teleop_twist_joy_node|twist_mux|robot_state_publisher)' "$1")" -eq 4 ] \
    && [ -z "$(sort "$1" | uniq -d)" ]
}

mega_fingida() {
  local nome argv0 pid pgid start d caso
  echo "== externos de mesmo nome, no domínio $DOMINIO_EXT (o \"robô 2\" no mesmo PC) =="
  : > "$SAIDA/externos.txt"
  while read -r nome argv0; do
    ROS_DOMAIN_ID=$DOMINIO_EXT sobe_grupo "externo_$nome" "$SAIDA/externo_$nome.log" \
        bash -c 'exec -a "$0" python3 "$1" "$2"' "$argv0" "$V/externo.py" "$nome" || return
    pid=$ULTIMO_PID; set -- $(stat_de "$pid")
    echo "$pid $2 $3 $nome" >> "$SAIDA/externos.txt"
  done <<'EOF_EXT'
joy_node               /opt/ros/jazzy/lib/joy/joy_node
teleop_twist_joy_node  /opt/ros/jazzy/lib/teleop_twist_joy/teleop_node
twist_mux              /opt/ros/jazzy/lib/twist_mux/twist_mux
robot_state_publisher  /opt/ros/jazzy/lib/robot_state_publisher/robot_state_publisher
EOF_EXT
  cp "$SAIDA/externos.txt" "$SAIDA/externos_antes.txt"
  ps -o pid,pgid,sid,lstart,args -p "$(awk '{print $1}' "$SAIDA/externos.txt" | paste -sd,)" \
    > "$SAIDA/externos_ps_antes.txt"
  local i rc_nos=1
  for i in $(seq 1 6); do
    nos_do_dominio "$DOMINIO_EXT" "$SAIDA/externos_nos.txt"; rc_nos=$?
    [ "$rc_nos" -eq 0 ] && tem_os_4 "$SAIDA/externos_nos.txt" && break
  done
  if [ "$rc_nos" -eq 0 ] && tem_os_4 "$SAIDA/externos_nos.txt"; then
    anota "externos: 4 nós no domínio $DOMINIO_EXT" APROVADO
  else
    anota "externos: 4 nós no domínio $DOMINIO_EXT" REPROVADO "(código $rc_nos, externos_nos.txt)"
    return
  fi

  echo "== o sobe-robo3 no domínio dos externos tem de RECUSAR, sem matar =="
  ROS_DOMAIN_ID=$DOMINIO_EXT roda "$SAIDA/recusa.txt" bash bin/sobe-robo3 porta:=/dev/null
  local rc=$? faltam=0
  for nome in joy_node teleop_twist_joy_node twist_mux robot_state_publisher; do
    grep -q "/$nome\$" "$SAIDA/recusa.txt" || faltam=1
  done
  local vivos_ext=1
  while read -r pid pgid start nome; do
    set -- $(stat_de "$pid" || echo "- - -"); [ "$3" = "$start" ] || vivos_ext=0
  done < "$SAIDA/externos.txt"
  [ "$rc" -ne 0 ] && [ "$faltam" -eq 0 ] && [ "$vivos_ext" -eq 1 ] \
     && [ ! -e "$HOME/.local/state/sobe-robo3/grupos" ] \
    && anota "recusa: listou os 4, não matou, não registrou" APROVADO \
    || anota "recusa: listou os 4, não matou, não registrou" REPROVADO "(recusa.txt)"

  for caso in reproducao_14_09 padrao_hoje; do
    d="$SAIDA/$caso"; mkdir -p "$d"
    echo "== MEGA fingida · $caso =="
    sobe_grupo "mega_$caso" "$d/mega.log" python3 "$V/mega_fingida.py" "$d" "$caso" || return
    local mega=$ULTIMO_PID
    for i in $(seq 1 100); do [ -s "$d/pty.txt" ] && break; sleep 0.1; done
    [ -s "$d/pty.txt" ] || { anota "$caso: pty da MEGA fingida" REPROVADO; return; }
    local pty args
    pty="$(cat "$d/pty.txt")"
    args="$(python3 -c "import yaml,sys; print(' '.join(yaml.safe_load(open(sys.argv[1]))['cenarios'][sys.argv[2]]['argumentos']))" "$V/frames_esperados.yaml" "$caso")"
    # shellcheck disable=SC2086
    if roda "$d/sobe.txt" bash bin/sobe-robo3 porta:="$pty" $args; then
      anota "$caso: sobe-robo3 subiu (placa, bateria, /joy)" APROVADO
    else
      anota "$caso: sobe-robo3 subiu (placa, bateria, /joy)" REPROVADO "($caso/sobe.txt)"
    fi
    cp "$HOME/.local/state/sobe-robo3/grupos" "$d/grupos_sobe_robo3.txt" 2>/dev/null \
      || : > "$d/grupos_sobe_robo3.txt"
    captura "$V/esperados_robo3_mega.yaml" "$d/captura" 90
    confere_nos "$V/esperados_robo3_mega.yaml" "$DOMINIO" "$caso"
    echo "   fases do /joy e TF (mega.log) ..."
    touch "$d/vai"
    # A MEGA fingida grava mega.yaml e CONTINUA de pé (pty aberto, STATE a
    # 50 Hz) até o `fim`: o --mata tem de achá-la viva, e ela fora do grupo
    # do sobe-robo3 tem de sobreviver a ele.
    for i in $(seq 1 600); do [ -s "$d/mega.yaml" ] && break; sleep 0.1; done
    if grep -q "^veredito: APROVADO" "$d/mega.yaml" 2>/dev/null; then
      anota "$caso: frames exatos + TF base_link→livox_frame" APROVADO
    else
      anota "$caso: frames exatos + TF base_link→livox_frame" REPROVADO "($caso/mega.yaml)"
    fi
    sed 's/^/      /' "$d/mega.log" | tail -8

    echo "== $caso: sobe-robo3 --mata e quem morreu =="
    python3 "$V/processos.py" foto "$d/antes_mata.csv"
    roda "$d/mata.txt" bash bin/sobe-robo3 --mata \
      && anota "$caso: sobe-robo3 --mata limpo" APROVADO \
      || anota "$caso: sobe-robo3 --mata limpo" REPROVADO "($caso/mata.txt)"
    python3 "$V/processos.py" foto "$d/depois_mata.csv"
    if roda "$d/quem_morreu.log" python3 "$V/processos.py" compara "$d/antes_mata.csv" \
         "$d/depois_mata.csv" "$d/grupos_sobe_robo3.txt" "$SAIDA/externos.txt" \
         "$d/quem_morreu.yaml"; then
      anota "$caso: só o grupo registrado morreu; externos vivos" APROVADO
    else
      anota "$caso: só o grupo registrado morreu; externos vivos" REPROVADO "($caso/quem_morreu.yaml)"
    fi
    if nos_do_dominio "$DOMINIO_EXT" "$d/externos_nos_depois.txt" \
         && tem_os_4 "$d/externos_nos_depois.txt"; then
      anota "$caso: os 4 externos ainda no grafo do domínio $DOMINIO_EXT" APROVADO
    else
      anota "$caso: os 4 externos ainda no grafo do domínio $DOMINIO_EXT" REPROVADO "($caso/externos_nos_depois.txt)"
    fi
    local rc_43
    nos_do_dominio "$DOMINIO" "$d/nos_depois_mata.txt"; rc_43=$?
    if [ "$rc_43" -ne 0 ]; then
      anota "$caso: domínio $DOMINIO sem nós depois do --mata" REPROVADO "(consulta falhou, código $rc_43)"
    elif [ -s "$d/nos_depois_mata.txt" ]; then
      anota "$caso: domínio $DOMINIO sem nós depois do --mata" REPROVADO "($caso/nos_depois_mata.txt)"
    else
      anota "$caso: domínio $DOMINIO sem nós depois do --mata" APROVADO
    fi
    [ -e "$HOME/.local/state/sobe-robo3/grupos" ] \
      && anota "$caso: registro do sobe-robo3 removido" REPROVADO \
      || anota "$caso: registro do sobe-robo3 removido" APROVADO
    awk -F, -v p="$mega" '$1 == p { achou = 1 } END { exit !achou }' "$d/depois_mata.csv" \
      && anota "$caso: a MEGA fingida (fora do grupo) sobreviveu ao --mata" APROVADO \
      || anota "$caso: a MEGA fingida (fora do grupo) sobreviveu ao --mata" REPROVADO
    touch "$d/fim"
    # Ela sai sozinha ao ver o `fim`; se não sair, a limpeza a derruba (grupo
    # registrado, com identidade).
    for i in $(seq 1 100); do
      st="$(stat_de "$mega")" || break
      case "$st" in Z*) break ;; esac
      sleep 0.1
    done
  done
  ps -o pid,pgid,sid,lstart,args -p "$(awk '{print $1}' "$SAIDA/externos.txt" | paste -sd,)" \
    > "$SAIDA/externos_ps_depois.txt"
}

case "$CENARIO" in
  robo2-gazebo) robo2_gazebo ;;
  robo3-gazebo) robo3_gazebo ;;
  mega-fingida) mega_fingida ;;
esac
limpa

echo
echo "== resultado ($RESULTADO) =="
sed 's/^/   /' "$RESULTADO"
if grep -q " REPROVADO" "$RESULTADO"; then
  echo "   🔴 REPROVADO em algum item — NÃO mexa em nada; a pasta é a prova: $SAIDA"
  exit 1
fi
echo "   🟢 APROVADO — pasta: $SAIDA"
