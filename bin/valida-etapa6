#!/usr/bin/env bash
# Validação da etapa 6 — a PILHA sobe o ROBÔ 3 no Gazebo, headless
# (docs/PLANO_ETAPA6_ROBO3.md §5.2). Os bin/valida-etapa4 e bin/valida-etapa5
# são evidência congelada e NÃO mudam; a infraestrutura de segurança foi
# COPIADA para tools/valida_etapa6/ (marca, sinal só com identidade reconferida,
# consulta ao grafo com erro reprova, limpeza em EXIT).
#
#   bash bin/valida-etapa6
#
# Sobe `pilha.launch.py robo:=3 sim:=true gui:=false rviz:=false`, espera o grafo
# ficar PRONTO e ESTÁVEL, colhe as provas, derruba e confere que não sobrou
# nada. Os oito itens do §4 menos o objetivo curto (§4.6), que é o passo 7 —
# aqui NÃO se manda objetivo nenhum.
#
# Pasta nova por chamada: ~/etapa6/<carimbo>/, e ela é a RAIZ DE EVIDÊNCIAS:
# console, launch.log, resultado.csv, a pasta da corrida (com os DOIS YAMLs
# materializados e o bag) e o SHA256SUMS. 🔴 A pasta É PRESERVADA mesmo quando
# reprova — sobretudo quando reprova: é a única cópia do que aconteceu.
#
# NUNCA mata por nome, e NUNCA `pkill -f` (já matou uma sessão ssh neste
# projeto). Robô físico e notebook NÃO participam desta validação.
set +u
R="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DOMINIO=47

CARIMBO="$(date +%Y%m%d_%H%M%S)"
SAIDA="$HOME/etapa6/$CARIMBO"
[ -e "$SAIDA" ] && { echo "🔴 $SAIDA já existe — não reaproveito pasta"; exit 1; }
mkdir -p "$SAIDA" || exit 1
exec > >(tee -a "$SAIDA/console.txt") 2>&1
GRUPOS="$SAIDA/grupos_wrapper.txt"; : > "$GRUPOS"
RESULTADO="$SAIDA/resultado.txt"; : > "$RESULTADO"
RESULTADO_CSV="$SAIDA/resultado.csv"
printf '"item","veredito","detalhe"\n' > "$RESULTADO_CSV"
V="$R/tools/valida_etapa6"
export ROS_DOMAIN_ID="$DOMINIO"
export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
# O transporte do Gazebo não olha o ROS_DOMAIN_ID: partição própria por rodada.
export GZ_PARTITION="valida_etapa6_$CARIMBO"
DOMINIOS_USADOS="$DOMINIO"

# anota, roda, stat_de, sobe_grupo, nos_do_dominio, limpa, instala_limpeza
source "$V/lib.sh"

# ── pré-condições (antes de subir QUALQUER coisa) ─────────────────────────────

echo "== validação etapa 6 · pilha do robô 3 no Gazebo · $CARIMBO =="
echo "   pasta: $SAIDA · ROS_DOMAIN_ID=$DOMINIO · só localhost · GZ_PARTITION=$GZ_PARTITION"
{ echo "commit: $(git -C "$R" rev-parse HEAD)"; git -C "$R" log -1 --format='%h %ad %s' --date=iso
  echo "branch: $(git -C "$R" rev-parse --abbrev-ref HEAD)"
  echo "status --porcelain (vazio = limpo):"; git -C "$R" status --porcelain; } > "$SAIDA/git.txt"
if [ -n "$(git -C "$R" status --porcelain)" ]; then
  echo "   🔴 árvore com mudança não commitada — a proveniência seria falsa:"
  git -C "$R" status --porcelain | sed 's/^/      /'; exit 1
fi
PRE="$(ps -eo pid,user,args | grep -E '(^|[ /])(ros2|gz|rviz2|_ros2_daemon)( |$)|/opt/ros/[a-z]+/lib/|/install/[a-z_]+/lib/|ros2cli\.daemon' | grep -vE 'grep -E|valida-etapa[456]')"
if [ -n "$PRE" ]; then
  echo "   🔴 já tem ROS/Gazebo de pé neste PC — não subo por cima nem mato nada:"
  echo "$PRE" | sed 's/^/      /'; exit 1
fi
if grep -lsa "VALIDA_ETAPA4_MARCA=" /proc/[0-9]*/environ 2>/dev/null | grep -q .; then
  echo "   🔴 há processo marcado de uma rodada anterior:"
  grep -lsa "VALIDA_ETAPA4_MARCA=" /proc/[0-9]*/environ | sed 's|/environ||;s|^|      |'; exit 1
fi

# A marca entra SÓ agora, depois das pré-condições: antes disso o próprio grep
# que procura marca de rodada anterior a teria (e se acharia). Daqui em diante
# todo processo lançado a herda.
export VALIDA_ETAPA4_MARCA="$SAIDA"
# Daqui em diante TODA saída (build falhou, Ctrl+C, fim normal) passa pela
# limpeza — idempotente.
instala_limpeza

cd "$R" || exit 1
source /opt/ros/jazzy/setup.bash

# ── reconstruir ANTES de rodar, e provar que o install/ é o fonte ─────────────
#
# 🔴 O `install/` deste projeto é `--symlink-install`: arquivo EXISTENTE aponta
# para o fonte, mas arquivo NOVO só ganha symlink no build. Foi exatamente isso
# que escondeu o `twist_mux_pilha_robo3.yaml` no passo 5. Reconstruir aqui é o
# que impede a corrida de medir uma árvore que não é a do commit.
echo "== compilando robot_base robot_motion robot_nav (build.log) =="
if ! roda "$SAIDA/build.log" colcon build --symlink-install \
     --packages-select robot_base robot_motion robot_nav; then
  anota "build" REPROVADO; exit 1
fi
source install/setup.bash
DIF=0
while read -r pkg padrao destino; do
  while IFS= read -r f; do
    cmp -s "$f" "install/$pkg/share/$pkg/$destino/$(basename "$f")" \
      || { echo "   🔴 install/ difere do fonte: $f"; DIF=1; }
  done < <(git ls-files "$padrao")
done <<'EOF_LISTA'
robot_base   ros2_packages/robot_base/package.xml            .
robot_base   ros2_packages/robot_base/launch/*.py            launch
robot_base   ros2_packages/robot_base/config/*               config
robot_base   ros2_packages/robot_base/description/*.xacro    description
robot_base   worlds/*.sdf                                    worlds
robot_motion ros2_packages/robot_motion/package.xml          .
robot_motion ros2_packages/robot_motion/config/*.yaml        config
robot_motion ros2_packages/robot_motion/launch/*.py          launch
robot_motion ros2_packages/robot_motion/rviz/*.rviz          rviz
robot_motion ros2_packages/robot_motion/behavior_trees/*.xml behavior_trees
robot_nav    ros2_packages/robot_nav/package.xml             .
robot_nav    ros2_packages/robot_nav/launch/*.py             launch
robot_nav    ros2_packages/robot_nav/urdf/*                  urdf
robot_nav    ros2_packages/robot_nav/config/*                config
robot_nav    ros2_packages/robot_nav/behavior_trees/*.xml    behavior_trees
EOF_LISTA
[ "$DIF" -ne 0 ] && { anota "install/ igual ao fonte" REPROVADO; exit 1; }
anota "build + install/ igual ao fonte" APROVADO

SHARE_MOTION="$(ros2 pkg prefix --share robot_motion 2>/dev/null)"
SHARE_BASE="$(ros2 pkg prefix --share robot_base 2>/dev/null)"
{ date -Is; uname -a; echo "hostname: $(hostname)"
  echo "ROS_DISTRO=$ROS_DISTRO"; echo "ros2 no PATH: $(command -v ros2)"
  echo "share robot_motion: $SHARE_MOTION"; echo "share robot_base: $SHARE_BASE"
  printenv | grep -E '^(ROS|RMW|AMENT|COLCON|GZ|IGN|FASTRTPS|CYCLONEDDS|PYTHONPATH|VALIDA)' | sort
} > "$SAIDA/ambiente.txt"

# ── a corrida ─────────────────────────────────────────────────────────────────
#
# `log_dir:=$SAIDA` faz a pasta da corrida nascer DENTRO da raiz de evidências:
# é lá que os dois YAMLs materializados e o bag vão ficar, ao lado do console.
# `rviz:=false` e `gui:=false` porque isto roda headless; `robo:=3` no argv é
# obrigatório — a seleção do perfil é por argv (decisão 056), e passar só pelo
# contexto morre na trava de coerência, de propósito.
echo "== subindo a pilha do robô 3 (headless) =="
sobe_grupo "pilha_robo3" "$SAIDA/launch.log" \
  ros2 launch robot_motion pilha.launch.py \
    robo:=3 sim:=true gui:=false rviz:=false log_dir:="$SAIDA" || exit 1

# A pasta da corrida: o carimbo é da SUBIDA da launch, então não se adivinha —
# procura-se. Com prazo: se ela não aparecer, a materialização não rodou.
CORRIDA=""
for i in $(seq 1 300); do
  CORRIDA="$(find "$SAIDA" -maxdepth 1 -type d -name 'corrida_*' | head -1)"
  [ -n "$CORRIDA" ] && break
  sleep 0.2
done
if [ -n "$CORRIDA" ]; then
  anota "pasta da corrida criada (raiz de evidências)" APROVADO "$(basename "$CORRIDA")"
else
  anota "pasta da corrida criada (raiz de evidências)" REPROVADO "(nenhuma corrida_* em $SAIDA)"
fi

echo "== captura: grafo pronto e estável + parâmetros vivos =="
if roda "$SAIDA/captura.log" python3 tools/linha_de_base/captura.py \
     "$V/esperados_pilha_robo3.yaml" "$SAIDA/captura" --prazo 180; then
  anota "grafo pronto e estável, lista de nós = esperada" APROVADO
else
  anota "grafo pronto e estável, lista de nós = esperada" REPROVADO "(captura/resumo.yaml)"
fi
nos_do_dominio "$DOMINIO" "$SAIDA/nos.txt"
sort "$SAIDA/nos.txt" | uniq -d > "$SAIDA/nos_uniq_d.txt"
[ -s "$SAIDA/nos_uniq_d.txt" ] \
  && anota "nenhum nome de nó duplicado no grafo" REPROVADO "(nos_uniq_d.txt)" \
  || anota "nenhum nome de nó duplicado no grafo" APROVADO

echo "== provas vivas: /Odometry, /scan, TF, WheelSpeeds ausente =="
roda "$SAIDA/topicos.log" python3 "$V/topicos.py" "$SAIDA/topicos.yaml" --prazo 60
while IFS= read -r linha; do
  case "$linha" in
    APROVADO*|REPROVADO*) anota "${linha#* }" "${linha%% *}" "(topicos.yaml)" ;;
  esac
done < "$SAIDA/topicos.log"

echo "== conferência offline: mux, use_sim_time, footprint, materializados =="
roda "$SAIDA/confere.log" python3 "$V/confere.py" "$SAIDA/captura" \
  "${CORRIDA:-$SAIDA/corrida_ausente}" "$V/esperados_pilha_robo3.yaml" \
  "$SAIDA/confere.yaml" --share-motion "$SHARE_MOTION" --share-base "$SHARE_BASE"
while IFS= read -r linha; do
  case "$linha" in
    APROVADO*|REPROVADO*) anota "${linha#* }" "${linha%% *}" "(confere.yaml)" ;;
  esac
done < "$SAIDA/confere.log"

erros_do_launch() {
  grep -nE "\[ERROR\]|\[FATAL\]|process has died" "$1" > "$2"
  anota "linhas ERROR/FATAL/died em $(basename "$1")" ANOTADO \
    "$(wc -l < "$2") ($(basename "$2"))"
}
erros_do_launch "$SAIDA/launch.log" "$SAIDA/launch_erros.txt"

# ── finalização DIRIGIDA do gravador, ANTES de derrubar o resto ──────────────
#
# 🔴 O DEFEITO QUE ISTO CONSERTA foi medido na segunda corrida
# (20260924_111431): o `ros2 bag record` estava entre os dois processos que
# sobreviveram a 20 s de SIGINT do grupo e levaram KILL — e morto por KILL ele
# nunca escreve o `metadata.yaml`. Resultado: 229 MB de bag ASSINADO que o
# `ros2 bag info` recusa a abrir. Evidência que não abre é pior que evidência
# que falta, porque parece estar lá.
#
# Por que aqui e não na `lib.sh`: a política de grupo (sinal por identidade,
# INT e depois KILL) é COMPARTILHADA com as etapas 4 e 5, e corridas já fechadas
# dependem dela — há teste provando que aqueles arquivos continuam idênticos.
# Isto é um alvo ÚNICO, escolhido por argv e reconfirmado por (pid, starttime,
# marca) logo antes do sinal, com janela própria de 30 s para ele fechar o
# arquivo sozinho. Só depois o grupo cai.
# 🔴 O SINAL É SIGTERM, E ISSO FOI MEDIDO (24-09, quatro experimentos sem
# Gazebo). O `ros2 bag record` deste Jazzy NÃO responde a SIGINT: nem no pid, nem
# no grupo (o que o Ctrl+C do terminal faz), nem com 30 s de espera, e nem a
# diferença estava no `--use-sim-time`. Com SIGTERM ele sai em 0,42 s e escreve o
# `metadata.yaml`. Não é janela curta, é sinal errado — aumentar o tempo não
# mudaria o mecanismo.
python3 "$V/processos.py" foto "$SAIDA/antes_da_limpeza.csv"
ALVO="$(python3 "$V/processos.py" acha 'ros2 bag record' | head -1)"
if [ -n "$ALVO" ]; then
  echo "== encerramento dirigido do gravador ==" >> "$SAIDA/gravador.txt"
  echo "sinal: TERM · alvo (pid starttime): $ALVO" >> "$SAIDA/gravador.txt"
  T0=$(date +%s.%N)
  # shellcheck disable=SC2086
  python3 "$V/processos.py" sinaliza_um $ALVO TERM >> "$SAIDA/gravador.txt" 2>&1
  FECHOU=0
  for i in $(seq 1 300); do
    # shellcheck disable=SC2086
    if ! python3 "$V/processos.py" vivo $ALVO; then FECHOU=1; break; fi
    sleep 0.1
  done
  DUR=$(echo "$(date +%s.%N) - $T0" | bc)
  { echo "fechou=$FECHOU esperas=$i duracao_s=$DUR"
    # O status de saída não dá para colher com `wait`: o gravador é filho do
    # `ros2 launch`, não deste shell. Quem sabe dele é o launch, e ele registra
    # — "finished cleanly" contra "died". É essa a linha que vira evidência.
    echo "--- o que o launch diz do pid ${ALVO%% *}:"
    grep -E "process|pid" "$SAIDA/launch.log" | grep -F "${ALVO%% *}" | tail -3
  } >> "$SAIDA/gravador.txt"
  if [ "$FECHOU" -eq 1 ]; then
    anota "gravador: SIGTERM dirigido e saída natural em até 30 s" APROVADO \
      "(${DUR} s)"
  else
    anota "gravador: SIGTERM dirigido e saída natural em até 30 s" REPROVADO \
      "(não saiu em 30 s; gravador.txt)"
  fi
  if grep -qF "finished cleanly [pid ${ALVO%% *}]" "$SAIDA/launch.log"; then
    anota "gravador: o launch registrou saída limpa" APROVADO
  else
    anota "gravador: o launch registrou saída limpa" REPROVADO "(gravador.txt)"
  fi
  # Nenhum filho sobrevivente: gravador que deixa processo atrás continua
  # escrevendo no mcap depois de assinado, e aí o manifesto mente.
  SOBRAS="$(python3 "$V/processos.py" acha 'bag record'; \
            python3 "$V/processos.py" acha rosbag2)"
  if [ -z "$SOBRAS" ]; then
    anota "gravador: nenhum processo dele sobrou" APROVADO
  else
    echo "sobras: $SOBRAS" >> "$SAIDA/gravador.txt"
    anota "gravador: nenhum processo dele sobrou" REPROVADO "(gravador.txt)"
  fi
else
  # ⚠️ SEM BACKTICK aqui: dentro de aspas duplas ele é substituição de comando, e
  # a mensagem "não achei o ros2 bag record" EXECUTARIA um gravador.
  anota "gravador: SIGTERM dirigido e saída natural em até 30 s" REPROVADO \
    "(nenhum processo marcado com 'ros2 bag record' no argv)"
fi

# ── derrubar e provar que não sobrou órfão ────────────────────────────────────
limpa
python3 "$V/processos.py" foto "$SAIDA/depois_da_limpeza.csv"

# ── o bag tem de FECHAR SOZINHO, e ser legível ───────────────────────────────
#
# ⚠️ O `ros2 bag reindex` recupera o `metadata.yaml` de um mcap não finalizado
# (provado numa cópia em 24-09: 70 626 mensagens recuperadas). Ele entra aqui SÓ
# para preservar a evidência — e marca RECUPERADO, que força RC 1. Recuperação
# não transforma encerramento defeituoso em corrida aprovada: se o gravador não
# fechou sozinho, a corrida não presta para fechar a etapa, e o bag fica legível
# apenas para eu poder ler o que houve.
if [ -n "$CORRIDA" ] && [ -d "$CORRIDA/bag" ]; then
  if [ -f "$CORRIDA/bag/metadata.yaml" ]; then
    anota "bag: metadata.yaml escrito pelo próprio gravador" APROVADO
  else
    roda "$SAIDA/reindex.log" ros2 bag reindex "$CORRIDA/bag"
    anota "bag: metadata.yaml escrito pelo próprio gravador" RECUPERADO \
      "(reindex; encerramento defeituoso — RC 1)"
  fi
  if roda "$SAIDA/bag_info.txt" ros2 bag info "$CORRIDA/bag"; then
    anota "bag: ros2 bag info com código 0" APROVADO
  else
    anota "bag: ros2 bag info com código 0" REPROVADO "(bag_info.txt)"
  fi
else
  anota "bag: metadata.yaml escrito pelo próprio gravador" REPROVADO \
    "(não há pasta bag)"
fi

# ── o escopo do manifesto, conferido ANTES de assinar ─────────────────────────
#
# 🔴 A ORDEM AQUI É O CONSERTO DE 24-09, e ela vem de um defeito medido: nas duas
# primeiras corridas o `SHA256SUMS` era gerado ANTES das últimas linhas do
# resultado, e o `sha256sum -c` da própria pasta falhava em três arquivos
# (`console.txt`, `resultado.txt`, `resultado.csv`). Nada estava corrompido — os
# YAMLs materializados e o bag batiam byte a byte —, mas manifesto que não fecha
# contra a própria pasta faz duvidar também do que está certo, e num PIBIT a
# pasta é a prova.
#
# A regra passou a ser: o manifesto é a ÚLTIMA ESCRITA do validador. Depois dele,
# só saída para o `console.txt` — que é o único arquivo de fora, porque ele é o
# log AO VIVO e não pode assinar a si mesmo enquanto ainda está sendo escrito. O
# conteúdo dele está reproduzido no `resultado.txt`, que fica assinado.
ESCOPO="$SAIDA/escopo_do_manifesto.txt"
( cd "$SAIDA" && find . -type f ! -name SHA256SUMS ! -name console.txt \
    ! -name "$(basename "$ESCOPO")" -print | sort ) > "$ESCOPO"
# E o próprio escopo entra no que ele lista: ele é a declaração do que foi
# assinado, e declaração fora do manifesto é declaração que se pode trocar
# depois. Nada mais escreve nele daqui em diante, então o hash fecha.
echo "./$(basename "$ESCOPO")" >> "$ESCOPO"
if [ -n "$CORRIDA" ]; then
  for y in "$CORRIDA"/*.yaml; do
    [ -e "$y" ] && echo "   YAML materializado: $y"
  done
fi
# A conferência é do ESCOPO, não do manifesto já feito: o que se quer garantir é
# que os artefatos que importam VÃO SER assinados. Os dois YAMLs materializados e
# o bag são a prova da corrida; assinar a pasta sem eles seria assinar o invólucro.
FALTA_NO_ESCOPO=""
if [ -n "$CORRIDA" ]; then
  C="$(basename "$CORRIDA")"
  for exigido in "$C/perfil_nav2.yaml" "$C/perfil_collision_monitor.yaml"; do
    grep -qx "./$exigido" "$ESCOPO" || FALTA_NO_ESCOPO="$FALTA_NO_ESCOPO $exigido"
  done
  grep -q "^\./$C/bag/" "$ESCOPO" || FALTA_NO_ESCOPO="$FALTA_NO_ESCOPO $C/bag/*"
else
  FALTA_NO_ESCOPO=" (não houve pasta de corrida)"
fi
grep -qx "./resultado.csv" "$ESCOPO" || FALTA_NO_ESCOPO="$FALTA_NO_ESCOPO resultado.csv"
# ⚠️ ESTA É A ÚLTIMA CHAMADA A `anota` DO VALIDADOR. Há teste estático travando
# isso (test_valida_etapa6.py): `anota` depois do manifesto o invalidaria de
# novo, que é exatamente o defeito que este bloco existe para consertar.
if [ -z "$FALTA_NO_ESCOPO" ]; then
  anota "escopo a assinar inclui os YAMLs, o bag e o resultado" APROVADO \
    "$(wc -l < "$ESCOPO") arquivos"
else
  anota "escopo a assinar inclui os YAMLs, o bag e o resultado" REPROVADO \
    "(falta:$FALTA_NO_ESCOPO)"
fi

echo
echo "== resultado ($RESULTADO_CSV) =="
sed 's/^/   /' "$RESULTADO"
# 🔴 RECUPERADO conta como reprovação para o código de saída: um bag que só abriu
# porque foi reindexado é evidência preservada, não corrida aprovada.
REPROVOU=0
grep -qE " (REPROVADO|RECUPERADO)" "$RESULTADO" && REPROVOU=1

# ── o manifesto, e ele é a ÚLTIMA ESCRITA ────────────────────────────────────
( cd "$SAIDA" && xargs -a "$(basename "$ESCOPO")" -d '\n' sha256sum > SHA256SUMS )

# ── e o validador confere o próprio manifesto ────────────────────────────────
# Sem isto, "tem SHA256SUMS" passaria por "o SHA256SUMS fecha" — que é a
# diferença entre as duas primeiras corridas e esta. Falha aqui força RC 1.
MANIFESTO=0
if ( cd "$SAIDA" && sha256sum -c SHA256SUMS --quiet ); then
  echo "   🟢 SHA256SUMS confere com a pasta ($(wc -l < "$SAIDA/SHA256SUMS") arquivos)"
else
  echo "   🔴 SHA256SUMS NÃO confere com a própria pasta"
  MANIFESTO=1
fi

if [ "$REPROVOU" -ne 0 ] || [ "$MANIFESTO" -ne 0 ]; then
  echo "   🔴 REPROVADO — NÃO mexa em nada; a pasta é a prova: $SAIDA"
  exit 1
fi
echo "   🟢 APROVADO — pasta: $SAIDA"
