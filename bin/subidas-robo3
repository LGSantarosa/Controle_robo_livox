#!/usr/bin/env bash
# Subidas repetidas do robô 3 no Gazebo headless — decisão 061.
#
#   bash bin/subidas-robo3 [N]        N subidas (padrão 20), uma por vez, cada uma limpa
#
# Cada subida: varredura de resíduo ANTES (processo ROS/Gazebo, qualquer marca,
# segmento DDS em /dev/shm, nó no domínio) → a pilha com os argumentos da
# corrida do passo 7 → a espera do valida-etapa7 (Nav2 active + TF) → UMA
# leitura dos controladores (serviço do controller_manager) e UMA janela de
# /joint_states → a limpeza da etapa 6
# como está → uma linha no subidas.csv. Amostrador de carga e pressão de CPU
# durante a janela inteira.
#
#   · falha de subida: registrada, e a bateria CONTINUA se a limpeza fechar;
#   · resíduo (limpeza reprovada ou varredura suja): a bateria PARA, INCOMPLETA.
#
# Veredito em veredito.txt: ESTÁVEL só com N/N; RC 0 só nele e com o manifesto
# fechando. Pasta: ~/subidas-robo3/<carimbo>/ (subida_NN/ por subida).
#
# Teste offline: tools/subidas_robo3/test_wrapper_subidas.py, com os comandos
# calçados por SUBIDAS_CALCOS (re-prefixado no PATH depois de CADA `source`),
# SUBIDAS_RAIZ_SAIDA, SUBIDAS_DOMINIO, SUBIDAS_SHM e SUBIDAS_ROS_SETUP. Fora do
# teste, nenhum deles existe.
#
# ⚠️ Não prova a causa de nada; mede em que condições a subida falha ou o
# limite da taxa. NUNCA mata por nome.
set +u

if [ -z "$SUBIDAS_AMBIENTE_LIMPO" ]; then
  exec env -u AMENT_PREFIX_PATH -u CMAKE_PREFIX_PATH -u COLCON_PREFIX_PATH \
           -u PYTHONPATH -u LD_LIBRARY_PATH -u ROS_DISTRO -u VALIDA_ETAPA4_MARCA \
           SUBIDAS_AMBIENTE_LIMPO=1 bash "$0" "$@"
fi

N="${1:-20}"
[[ "$N" =~ ^[1-9][0-9]?$ ]] || { echo "uso: bash bin/subidas-robo3 [N: 1..99]"; exit 2; }

R="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DOMINIO="${SUBIDAS_DOMINIO:-50}"     # 47 etapa 6 · 48 explora · 49 etapa 7
PRAZO_PRONTO=300                      # s de parede até Nav2 active + TF
JANELA_JS=8                           # s de parede da janela de /joint_states
SHM="${SUBIDAS_SHM:-/dev/shm}"          # onde o Fast DDS deixa os segmentos
calcos() { [ -n "$SUBIDAS_CALCOS" ] && export PATH="$SUBIDAS_CALCOS:$PATH"; }
calcos

CARIMBO="$(date +%Y%m%d_%H%M%S)"
BASE="${SUBIDAS_RAIZ_SAIDA:-$HOME/subidas-robo3}/$CARIMBO"
[ -e "$BASE" ] && { echo "🔴 $BASE já existe — não reaproveito pasta"; exit 1; }
mkdir -p "$BASE" || exit 1
exec > >(tee -a "$BASE/console.txt") 2>&1

V="$R/tools/valida_etapa6"
M="$R/tools/subidas_robo3/mede.py"
RS="$R/tools/subidas_robo3/shm_recupera.py"
CSV="$BASE/subidas.csv"
export ROS_DOMAIN_ID="$DOMINIO"
export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
DOMINIOS_USADOS="$DOMINIO"
# O que a lib da etapa 6 espera; apontado para a subida corrente a cada volta.
SAIDA="$BASE"; GRUPOS="$BASE/grupos_base.txt"; : > "$GRUPOS"
RESULTADO="$BASE/resultado_base.txt"; : > "$RESULTADO"
source "$V/lib.sh"

echo "== subidas do robô 3 · $N × headless · $CARIMBO =="
echo "   pasta: $BASE · ROS_DOMAIN_ID=$DOMINIO"
{ echo "commit: $(git -C "$R" rev-parse HEAD)"; git -C "$R" log -1 --format='%h %ad %s' --date=iso
  echo "branch: $(git -C "$R" rev-parse --abbrev-ref HEAD)"
  echo "status --porcelain (vazio = limpo):"; git -C "$R" status --porcelain; } > "$BASE/git.txt"
if [ -n "$(git -C "$R" status --porcelain)" ]; then
  echo "   🔴 árvore com mudança não commitada:"; git -C "$R" status --porcelain | sed 's/^/      /'
  exit 1
fi

# ── resíduo: processo ROS/Gazebo, QUALQUER marca, DDS em /dev/shm, nó no domínio ──
# Sem a marca no ambiente dos comandos: a marca da subida corrente está
# exportada, e o próprio `grep` a herdaria e se acusaria.
varre_residuo() {   # varre_residuo <arquivo> — 0 se limpo
  local f="$1" sujo=0 pre marcas shm nos rc
  pre="$(env -u VALIDA_ETAPA4_MARCA ps -eo pid,user,args \
    | grep -E '(^|[ /])(ros2|gz|rviz2|_ros2_daemon)( |$)|/opt/ros/[a-z]+/lib/|/install/[a-z_]+/lib/|ros2cli\.daemon' \
    | grep -vE 'grep -E|subidas-robo3|valida-etapa[4567]|explora-objetivo')"
  marcas="$(env -u VALIDA_ETAPA4_MARCA grep -lsa 'VALIDA_ETAPA4_MARCA=' /proc/[0-9]*/environ 2>/dev/null)"
  shm="$(ls "$SHM" 2>/dev/null | grep -iE 'fastrtps|fast_datasharing')"
  nos="$(env -u VALIDA_ETAPA4_MARCA ROS_DOMAIN_ID="$DOMINIO" ros2 node list --no-daemon --spin-time 5 2>&1)"; rc=$?
  { echo "processos ROS/Gazebo:"; echo "${pre:-   (nenhum)}"
    echo "processos com marca:"; echo "${marcas:-   (nenhum)}"
    echo "segmentos DDS em $SHM:"; echo "${shm:-   (nenhum)}"
    echo "domínio $DOMINIO (rc $rc):"; echo "${nos:-   (nenhum nó)}"; } > "$f"
  [ -n "$pre" ] && sujo=1; [ -n "$marcas" ] && sujo=1; [ -n "$shm" ] && sujo=1
  [ "$rc" -ne 0 ] && sujo=1; [ -n "$nos" ] && sujo=1
  return $sujo
}

# ── o ambiente do ROS ANTES da primeira chamada `ros2` ──────────────────────
# A reexecução do topo apagou AMENT_PREFIX_PATH e PYTHONPATH; sem o `source`, o
# `ros2` quebra (PackageNotFoundError) e a varredura acusaria resíduo que não
# existe — foi o que parou o ensaio de 28-09, 14h02 (pasta 20260928_140215,
# falha do instrumento, N=0). O código do `source` é conferido.
ROS_SETUP="${SUBIDAS_ROS_SETUP:-/opt/ros/jazzy/setup.bash}"
if ! source "$ROS_SETUP"; then
  echo "   🔴 o source de $ROS_SETUP falhou — nenhuma chamada ao ros2"; exit 1
fi
calcos

# ── segmentos Fast DDS: contar, inventariar, conferir dono ───────────────────
conta_shm() { ls "$SHM" 2>/dev/null | grep -ciE 'fastrtps|fast_datasharing'; }
shm_sem_dono() {   # 0 se NENHUM segmento tem processo segurando
  local f
  for f in "$SHM"/*; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in *fastrtps*|*fast_datasharing*) ;; *) continue ;; esac
    [ -n "$(fuser "$f" 2>/dev/null)" ] && return 1
  done
  return 0
}
inventaria_shm() {   # inventaria_shm <arquivo> <launch.log> — ANTES de limpar
  local f
  { echo "inventário: $(date --iso-8601=seconds), antes de qualquer fastdds shm clean"
    echo "== segmentos (ls -la --time-style=full-iso) =="
    ls -la --time-style=full-iso "$SHM" | grep -iE 'fastrtps|fast_datasharing'
    echo "== fuser, um por arquivo (vazio = ninguém segura) =="
    for f in "$SHM"/*; do
      case "$(basename "$f")" in *fastrtps*|*fast_datasharing*) ;; *) continue ;; esac
      echo "$f: $(fuser "$f" 2>&1)"
    done
    echo "== processos mortos no launch.log (depois do SIGINT e antes) =="
    grep -E 'process has died' "$2" || echo "(nenhum)"; } > "$1"
}
algo_vivo() {   # algo_vivo <arquivo> — 0 se há processo ROS/Gazebo, marca ou nó
  local pre marcas nos rc
  pre="$(env -u VALIDA_ETAPA4_MARCA ps -eo pid,user,args \
    | grep -E '(^|[ /])(ros2|gz|rviz2|_ros2_daemon)( |$)|/opt/ros/[a-z]+/lib/|/install/[a-z_]+/lib/|ros2cli\.daemon' \
    | grep -vE 'grep -E|subidas-robo3|valida-etapa[4567]|explora-objetivo')"
  marcas="$(env -u VALIDA_ETAPA4_MARCA grep -lsa 'VALIDA_ETAPA4_MARCA=' /proc/[0-9]*/environ 2>/dev/null)"
  nos="$(env -u VALIDA_ETAPA4_MARCA ROS_DOMAIN_ID="$DOMINIO" ros2 node list --no-daemon --spin-time 5 2>&1)"; rc=$?
  { echo "processos:"; echo "${pre:-   (nenhum)}"; echo "marcas:"; echo "${marcas:-   (nenhuma)}"
    echo "domínio $DOMINIO (rc $rc):"; echo "${nos:-   (nenhum nó)}"; } > "$1"
  [ -n "$pre" ] || [ -n "$marcas" ] || [ "$rc" -ne 0 ] || [ -n "$nos" ]
}

INTERROMPIDA=0
if ! varre_residuo "$BASE/residuo_inicial.txt"; then
  echo "   🔴 já há resíduo ROS/Gazebo neste PC — não subo nada:"; sed 's/^/      /' "$BASE/residuo_inicial.txt"
  exit 1
fi

export VALIDA_ETAPA4_MARCA="$BASE"
FINALIZADO=0
finaliza() {
  [ "$FINALIZADO" -eq 1 ] && return
  limpa          # idempotente: só age se uma subida ficou pela metade
  FINALIZADO=1
  local rc_v falta="" d
  [ -s "$CSV" ] || python3 "$M" cabecalho > "$CSV"
  python3 "$M" veredito "$CSV" "$N" "$INTERROMPIDA" > "$BASE/veredito.txt"; rc_v=$?
  echo; echo "== veredito =="; sed 's/^/   /' "$BASE/veredito.txt"
  # O manifesto no padrão da etapa 7: escopo declarado (pipefail), sem o
  # console, conferido contra os artefatos, gerado e conferido; falha → RC 1.
  local E="$BASE/escopo_do_manifesto.txt"
  if ! ( set -o pipefail; cd "$BASE" && find . -type f ! -name SHA256SUMS \
           ! -name console.txt ! -name "$(basename "$E")" -print | sort ) > "$E"; then
    falta=" (a construção do escopo falhou)"
  fi
  echo "./$(basename "$E")" >> "$E"
  for d in git.txt subidas.csv veredito.txt; do
    grep -qx "./$d" "$E" || falta="$falta $d"
  done
  # `launch.log` só de quem SUBIU — cada linha do CSV. Subida barrada pela
  # varredura não tem launch (defeito de 14h12: o escopo o exigia).
  for d in $(tail -n +2 "$CSV" | cut -d, -f1); do
    d="subida_$(printf %02d "$d")"
    grep -qx "./$d/launch.log" "$E" || falta="$falta $d/launch.log"
  done
  local manifesto=0
  if ! ( cd "$BASE" && xargs -a "$(basename "$E")" -d '\n' sha256sum > SHA256SUMS ); then
    echo "   🔴 falhou ao gerar o SHA256SUMS"; manifesto=1
  elif ( cd "$BASE" && sha256sum -c SHA256SUMS --quiet ); then
    echo "   🟢 SHA256SUMS confere ($(wc -l < "$BASE/SHA256SUMS") arquivos; console.txt fora)"
  else
    echo "   🔴 SHA256SUMS NÃO confere com a pasta"; manifesto=1
  fi
  [ -n "$falta" ] && echo "   🔴 escopo sem os artefatos:$falta"
  if [ "$rc_v" -ne 0 ] || [ "$manifesto" -ne 0 ] || [ -n "$falta" ]; then
    echo "   🔴 $(head -c 12 "$BASE/veredito.txt") — pasta: $BASE"; exit 1
  fi
  echo "   🟢 ESTÁVEL — pasta: $BASE"; exit 0
}
instala_limpeza
trap 'limpa; finaliza' EXIT

cd "$R" || exit 1
echo "== compilando robot_base robot_motion robot_nav, UMA vez (build.log) =="
if ! roda "$BASE/build.log" colcon build --symlink-install \
     --packages-select robot_base robot_motion robot_nav; then
  echo "   🔴 build falhou — nenhuma subida"; INTERROMPIDA=1; exit 1
fi
source install/setup.bash; calcos
LIMPO=1        # o build rodou em primeiro plano e terminou: nada pendente
python3 "$M" cabecalho > "$CSV"

# ── uma subida ──────────────────────────────────────────────────────────────
NOS_ATIVOS="/bt_navigator /planner_server /controller_server"
esta_ativo() { [ "${1%% *}" = active ]; }

amostra_cpu() {   # epoch load1 psi_some_avg10 psi_some_total_us, a cada 1 s
  local l1 psi
  while :; do
    read -r l1 _ < /proc/loadavg
    psi="$(awk '/^some/{split($2,a,"=");split($5,b,"=");print a[2], b[2]}' /proc/pressure/cpu 2>/dev/null)"
    echo "$(date +%s.%N) $l1 ${psi:-nan 0}"
    sleep 1
  done
}

subida() {
  local i="$1" S T0 pronto=0 t_pronto="" lok
  S="$BASE/subida_$(printf %02d "$i")"; mkdir -p "$S"
  echo; echo "== subida $i/$N =="
  # Barrada pela varredura, a subida não sobe NADA: nenhuma limpeza pendente
  # nela (o LIMPO só volta a 0 depois daqui). Antes, o `trap` limpava esta
  # subida vazia DEPOIS do manifesto — defeito de 14h12.
  if ! varre_residuo "$S/residuo_antes.txt"; then
    echo "   🔴 resíduo antes da subida $i — a bateria para"; sed 's/^/      /' "$S/residuo_antes.txt"
    INTERROMPIDA=1; return 1
  fi
  SAIDA="$S"; GRUPOS="$S/grupos_wrapper.txt"; : > "$GRUPOS"
  RESULTADO="$S/resultado.txt"; : > "$RESULTADO"; LIMPO=0
  # O inventário ANTES: a remoção manual só alcança o que apareceu depois dele.
  python3 "$RS" inventaria "$SHM" "$S/shm_antes.tsv"
  # O amostrador é do wrapper, não da pilha: roda SEM marca, para o `sleep` dele
  # não aparecer como sobra na limpeza da subida.
  ( unset VALIDA_ETAPA4_MARCA; amostra_cpu ) > "$S/amostras.txt" 2>/dev/null &
  local AMOSTRADOR=$!
  export VALIDA_ETAPA4_MARCA="$S"
  export GZ_PARTITION="subidas_robo3_${CARIMBO}_$i"
  T0=$(date +%s.%N)
  if sobe_grupo "pilha_robo3" "$S/launch.log" \
       ros2 launch robot_motion pilha.launch.py \
         robo:=3 sim:=true gui:=false rviz:=false localizacao:=fixa bag:=false \
         log_dir:="$S"; then
    # A espera do valida-etapa7, igual: é nela que a falha apareceu.
    local T0_ESPERA; T0_ESPERA=$(date +%s)
    while [ $(( $(date +%s) - T0_ESPERA )) -lt "$PRAZO_PRONTO" ]; do
      local todos=1 no estado
      for no in $NOS_ATIVOS; do
        estado="$(timeout 10 ros2 lifecycle get "$no" 2>/dev/null | head -1)"
        esta_ativo "$estado" || todos=0
      done
      if [ "$todos" -eq 1 ] \
         && timeout 5 ros2 action list 2>>"$S/action_list.err" | grep -qx '/navigate_to_pose'; then
        timeout 5 ros2 run tf2_ros tf2_echo map base_link > "$S/tf_inicial.txt" 2>&1
        if grep -q 'Translation' "$S/tf_inicial.txt"; then
          pronto=1; t_pronto="$(python3 -c "import time;print(round(time.time()-$T0,1))")"; break
        fi
      fi
      sleep 1
    done
    # Uma leitura de cada, DEPOIS de pronto (ou do prazo), com timeout.
    # `ros2 control` (ros2controlcli) não existe neste PC: o serviço do
    # controller_manager, que dá a mesma lista.
    timeout 15 ros2 service call /controller_manager/list_controllers controller_manager_msgs/srv/ListControllers \
      > "$S/controladores.txt" 2>&1
    timeout -s INT "$JANELA_JS" ros2 topic echo /joint_states --field header.stamp.sec \
      > "$S/joint_states.txt" 2>&1
  fi
  kill "$AMOSTRADOR" 2>/dev/null; wait "$AMOSTRADOR" 2>/dev/null
  limpa
  if grep -qE '^limpeza: nada marcado, domínios vazios +APROVADO' "$RESULTADO"; then lok=1; else lok=0; fi
  # ── o teardown pela regra de 28-09 (decisão 061 §2.3) ──────────────────
  local fora segv orfaos recup=0 manual=0 motivo=""
  read -r fora segv < <(python3 "$M" sinais "$S/launch.log")
  orfaos="$(conta_shm)"
  if [ "$orfaos" -gt 0 ]; then
    inventaria_shm "$S/shm_inventario.txt" "$S/launch.log"
    python3 "$RS" inventaria "$SHM" "$S/shm_depois.tsv"
  fi
  if [ "$lok" -ne 1 ]; then
    motivo="limpeza reprovada (processo, marca ou nó vivo)"
  elif [ "${fora:-1}" -ne 0 ]; then
    motivo="sinal fora da regra (SIGSEGV antes do teardown, ou sinal em outro processo)"
  elif [ "$orfaos" -gt 0 ]; then
    if algo_vivo "$S/vivo_antes_do_shm_clean.txt" || ! shm_sem_dono; then
      motivo="segmento com dono ou algo vivo — o fastdds shm clean não roda"
    else
      echo "   🟠 $orfaos segmento(s) órfão(s) depois do teardown — fastdds shm clean"
      fastdds shm clean > "$S/shm_clean.txt" 2>&1
      if [ "$(conta_shm)" -eq 0 ]; then
        recup=1
      else
        # Os sem `_el`, que a ferramenta não reconhece (decisão 061 §2.3.2):
        # remoção manual controlada, com o "nada vivo" RECONFERIDO agora.
        ls -la --time-style=full-iso "$SHM" >> "$S/shm_clean.txt"
        if algo_vivo "$S/vivo_antes_da_remocao_manual.txt"; then
          motivo="algo vivo antes da remoção manual"
        elif python3 "$RS" remove "$SHM" "$S/shm_antes.tsv" "$S/shm_depois.tsv" \
               > "$S/shm_remocao_manual.txt" 2>&1 && [ "$(conta_shm)" -eq 0 ]; then
          recup=1; manual=1
          echo "   🟠 remoção manual controlada: $(grep -c '^  ' "$S/shm_remocao_manual.txt") arquivo(s)"
        else
          motivo="a remoção manual controlada recusou ou sobrou segmento (shm_remocao_manual.txt)"
        fi
      fi
    fi
  fi
  printf 'nav2_tf_pronto=%s\nt_nav2_tf_s=%s\njs_janela_s=%s\nlimpeza_ok=%s\nshm_orfaos=%s\nlimpeza_recuperada=%s\nlimpeza_manual_recuperada=%s\n' \
    "$pronto" "$t_pronto" "$JANELA_JS" "$lok" "$orfaos" "$recup" "$manual" > "$S/medidas.env"
  python3 "$M" linha "$S" "$i" >> "$CSV"
  echo "   $(tail -1 "$CSV")"
  if [ -n "$motivo" ]; then
    echo "   🔴 subida $i: $motivo — a bateria para"; INTERROMPIDA=1; return 1
  fi
}

for i in $(seq 1 "$N"); do
  subida "$i" || break
done
if [ "$INTERROMPIDA" -eq 0 ] && ! varre_residuo "$BASE/residuo_final.txt"; then
  echo "   🔴 resíduo depois da última subida"; INTERROMPIDA=1
fi
export VALIDA_ETAPA4_MARCA="$BASE"
finaliza
