#!/usr/bin/env bash
# Corrida EXPLORATÓRIA: o robô 3 recebe um objetivo de 1 m no Gazebo, COM JANELA.
#
#   bash bin/explora-objetivo-robo3
#
# 🔴 ISTO NÃO FECHA O PASSO 7, E NÃO É EVIDÊNCIA DE FECHAMENTO. O contrato do
# passo 7 (`docs/PLANO_ETAPA6_ROBO3.md` §4.6.1) exige TRÊS critérios medidos —
# `SUCCEEDED`, tolerância final e comando acima do patamar vivo chegando ao
# consumidor final. Aqui não se mede nada disso: sobe com `gui:=true
# rviz:=true`, manda UM objetivo e o dono OLHA. A janela muda o grafo e a carga,
# então nem a lista de nós nem os tempos desta corrida comparam com as cinco da
# etapa 6.
#
# Para que serve: descobrir CEDO se o movimento básico funciona — e, se não
# funcionar, ver COMO quebra (gira no lugar, sai de ré, trava em obstáculo que
# não existe). Duas horas de CSV não contam o que a tela conta em dois segundos.
#
# O que ele reaproveita da etapa 6, sem tocar em nada de lá: as pré-condições
# (não subir por cima de ROS de pé, não deixar marca de rodada anterior), a
# subida em grupo próprio, o encerramento DIRIGIDO do gravador com SIGTERM (o
# `ros2 bag record` deste Jazzy não responde a SIGINT — medido em 24-09) e a
# limpeza sem `pkill` (que já matou uma sessão ssh neste projeto).
#
# Robô físico e notebook NÃO participam: é tudo simulador neste PC.
set +u

# ── ambiente LIMPO, e isto é a PRIMEIRA coisa que acontece ──────────────────
#
# 🔴 `source /opt/ros/jazzy/setup.bash` ACRESCENTA; ele não remove o overlay que
# já estava no shell. Quem chama isto de um terminal que já deu `source
# install/setup.bash` (ou de outro workspace) carrega o caminho velho junto, e a
# corrida mede uma árvore que não é a que acabou de compilar — o modo de falha
# mais caro deste projeto, porque tudo PARECE certo.
#
# Por isso o wrapper se reexecuta uma vez, com as seis variáveis apagadas, e só
# então monta o ambiente do zero.
if [ -z "$EXPLORA_AMBIENTE_LIMPO" ]; then
  exec env -u AMENT_PREFIX_PATH -u CMAKE_PREFIX_PATH -u COLCON_PREFIX_PATH \
           -u PYTHONPATH -u LD_LIBRARY_PATH -u ROS_DISTRO \
           EXPLORA_AMBIENTE_LIMPO=1 bash "$0" "$@"
fi

R="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Domínio PRÓPRIO, diferente do 47 da etapa 6: se sobrar alguma coisa de uma
# corrida exploratória, ela não se mistura com a validação.
DOMINIO=48
TETO_SIMULADO=60          # segundos de tempo SIMULADO para o objetivo
# ⚠️ Não há coordenada de alvo aqui de propósito: o objetivo é RELATIVO à pose
# viva (1 m no rumo atual), calculado depois que a pilha sobe. Coordenada fixa
# neste arquivo foi o defeito de 24-09 — ver o bloco do cálculo, lá embaixo.
DISTANCIA_DO_OBJETIVO=1.0

CARIMBO="$(date +%Y%m%d_%H%M%S)"
SAIDA="$HOME/etapa7-explora/$CARIMBO"
[ -e "$SAIDA" ] && { echo "🔴 $SAIDA já existe — não reaproveito pasta"; exit 1; }
mkdir -p "$SAIDA" || exit 1
exec > >(tee -a "$SAIDA/console.txt") 2>&1
GRUPOS="$SAIDA/grupos_wrapper.txt"; : > "$GRUPOS"
RESULTADO="$SAIDA/resultado.txt"; : > "$RESULTADO"
RESULTADO_CSV="$SAIDA/resultado.csv"
printf '"item","veredito","detalhe"\n' > "$RESULTADO_CSV"
# A lib e o processos.py são os da etapa 6, usados COMO ESTÃO. Nenhuma linha de
# lá muda por causa desta corrida: a etapa 6 está fechada e as cinco pastas
# dependem daquele comportamento.
V="$R/tools/valida_etapa6"
export ROS_DOMAIN_ID="$DOMINIO"
export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
export GZ_PARTITION="explora_objetivo_$CARIMBO"
DOMINIOS_USADOS="$DOMINIO"
source "$V/lib.sh"

echo "== corrida EXPLORATÓRIA · objetivo de 1 m · robô 3 · $CARIMBO =="
echo "   pasta: $SAIDA · ROS_DOMAIN_ID=$DOMINIO · GZ_PARTITION=$GZ_PARTITION"
echo "   🔴 isto NÃO fecha o passo 7 — é para VER se anda."
{ echo "commit: $(git -C "$R" rev-parse HEAD)"; git -C "$R" log -1 --format='%h %ad %s' --date=iso
  echo "branch: $(git -C "$R" rev-parse --abbrev-ref HEAD)"
  echo "status --porcelain (vazio = limpo):"; git -C "$R" status --porcelain; } > "$SAIDA/git.txt"
# ⚠️ Árvore suja aqui AVISA e não barra (na etapa 6 ela barra, porque lá a
# proveniência é a prova). Numa exploratória, experimentar rápido é o ponto —
# mas o `git.txt` registra o estado, para não existir "corrida de commit
# desconhecido".
[ -n "$(git -C "$R" status --porcelain)" ] && \
  echo "   ⚠️ árvore com mudança não commitada — anotado em git.txt"

# ⚠️ `gui:=true rviz:=true` precisa de tela. Sem DISPLAY nem WAYLAND_DISPLAY o
# Gazebo e o RViz morrem lá na frente, depois do build e da subida — e o erro
# aparece como "a pilha não ficou pronta", que manda diagnosticar a coisa
# errada. Esta corrida existe para o dono OLHAR: sem tela, ela não tem sentido.
if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
  echo "   🔴 sem DISPLAY nem WAYLAND_DISPLAY — esta corrida é COM JANELA."
  echo "      rode no PC (não por ssh sem X), ou use o bin/valida-etapa6 headless."
  exit 1
fi
echo "   tela: DISPLAY=${DISPLAY:-(nenhum)} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-(nenhum)}"

PRE="$(ps -eo pid,user,args | grep -E '(^|[ /])(ros2|gz|rviz2|_ros2_daemon)( |$)|/opt/ros/[a-z]+/lib/|/install/[a-z_]+/lib/|ros2cli\.daemon' | grep -vE 'grep -E|valida-etapa[456]|explora-objetivo')"
if [ -n "$PRE" ]; then
  echo "   🔴 já tem ROS/Gazebo de pé neste PC — não subo por cima nem mato nada:"
  echo "$PRE" | sed 's/^/      /'; exit 1
fi
if grep -lsa "VALIDA_ETAPA4_MARCA=" /proc/[0-9]*/environ 2>/dev/null | grep -q .; then
  echo "   🔴 há processo marcado de uma rodada anterior:"
  grep -lsa "VALIDA_ETAPA4_MARCA=" /proc/[0-9]*/environ | sed 's|/environ||;s|^|      |'; exit 1
fi
export VALIDA_ETAPA4_MARCA="$SAIDA"

# 🔴 O BAG PRECISA FECHAR TAMBÉM QUANDO A CORRIDA ABORTA. Na tentativa de
# 24-09 a espera falhou, o script saiu pelo `exit 1`, e o encerramento dirigido
# do gravador — que estava lá embaixo, no caminho feliz — foi PULADO: sobraram
# 1,7 GB de `bag_0.mcap` sem `metadata.yaml`, que o `ros2 bag info` não abre.
# Evidência que não abre é pior que evidência que falta, porque parece estar lá
# (é a mesma lição da segunda corrida da etapa 6).
#
# Por isso o fechamento vira função idempotente e entra no `trap`, ANTES da
# limpeza — que é quem derruba o grupo e mataria o gravador por KILL.
GRAVADOR_FECHADO=0
fecha_gravador() {
  [ "$GRAVADOR_FECHADO" -eq 1 ] && return 0
  GRAVADOR_FECHADO=1
  local alvo i
  alvo="$(python3 "$V/processos.py" acha 'ros2 bag record' 2>/dev/null | head -1)"
  [ -z "$alvo" ] && return 0
  echo "== encerramento dirigido do gravador (TERM) ==" >> "$SAIDA/gravador.txt"
  # SIGTERM e não SIGINT: medido em 24-09 que o `ros2 bag record` deste Jazzy
  # NÃO responde a SIGINT, e morto por KILL ele nunca escreve o metadata.yaml.
  # shellcheck disable=SC2086
  python3 "$V/processos.py" sinaliza_um $alvo TERM >> "$SAIDA/gravador.txt" 2>&1
  for i in $(seq 1 300); do
    # shellcheck disable=SC2086
    python3 "$V/processos.py" vivo $alvo || break
    sleep 0.1
  done
  # shellcheck disable=SC2086
  if python3 "$V/processos.py" vivo $alvo; then
    anota "gravador encerrado por SIGTERM dirigido" REPROVADO "(não fechou em 30 s)"
  else
    anota "gravador encerrado por SIGTERM dirigido" ANOTADO "(gravador.txt)"
  fi
}

instala_limpeza
# O `instala_limpeza` da etapa 6 instala `trap limpa EXIT`; aqui o gravador
# entra ANTES dela, em toda saída — inclusive `exit 1` de pré-condição.
trap 'fecha_gravador; limpa' EXIT

cd "$R" || exit 1
source /opt/ros/jazzy/setup.bash

echo "== compilando robot_base robot_motion robot_nav (build.log) =="
if ! roda "$SAIDA/build.log" colcon build --symlink-install \
     --packages-select robot_base robot_motion robot_nav; then
  anota "build" REPROVADO; exit 1
fi
source install/setup.bash

# ── sobe COM JANELA ──────────────────────────────────────────────────────────
echo "== subindo a pilha do robô 3 COM Gazebo GUI e RViz =="
sobe_grupo "pilha_robo3_gui" "$SAIDA/launch.log" \
  ros2 launch robot_motion pilha.launch.py \
    robo:=3 sim:=true gui:=true rviz:=true localizacao:=fixa \
    log_dir:="$SAIDA" || exit 1
# ⚠️ `localizacao:=fixa` é EXPLÍCITO de propósito, mesmo sendo o default. O
# `/Odometry` está em `odom` e o objetivo vai em `map`: hoje eles coincidem
# porque o `tf_map_odom` publica `map→odom` como identidade — o que só vale na
# localização fixa. Depender do default aqui repetiria exatamente o erro do
# spawn: um valor que "é assim hoje" e que ninguém escreveu em lugar nenhum.
# Com `localizacao:=amcl` a identidade some e a conta pose+1 m passaria a
# misturar dois referenciais.

# ── esperar o que o objetivo PRECISA, e só isso ─────────────────────────────
#
# Aqui NÃO se usa a captura da etapa 6: a lista de nós esperada de lá é a da
# corrida headless, e com `rviz:=true` ela muda (o RViz traz nó e listener de
# TF próprios — foi essa conta que corrigiu a cardinalidade no passo 6b).
# Espera-se o necessário para mandar goal: o servidor da ação de pé e a TF da
# pose resolvendo.
echo "== esperando Nav2 ATIVO + TF map->base_link (até 300 s) =="
#
# 🔴 AÇÃO LISTADA NÃO É NAV2 PRONTO. O `/navigate_to_pose` aparece assim que o
# `bt_navigator` sobe — antes de o gerenciador de ciclo de vida ativar os
# servidores. Goal mandado nessa janela é aceito e morre sem plano, e o sintoma
# ("a ação abortou") não aponta para a causa. Por isso se exige o ESTADO
# `active` dos três que fazem o objetivo andar:
#   · bt_navigator      — quem executa a árvore
#   · planner_server    — quem traça o caminho
#   · controller_server — quem gera o comando
NOS_ATIVOS="/bt_navigator /planner_server /controller_server"

# 🔴 A COMPARAÇÃO É EXATA, E ISSO NÃO É PREFERÊNCIA DE ESTILO. O
# `ros2 lifecycle get` responde `active [3]`, `inactive [2]`, `unconfigured [1]`
# — e o casamento frouxo `*active*` aceita **inactive**, que é justamente o
# estado da janela que esta espera existe para fechar. Só o PRIMEIRO campo, e
# igual a `active`.
esta_ativo() {   # esta_ativo "<saída do lifecycle get>"
  [ "${1%% *}" = active ]
}

# ⚠️ PRAZO DE PAREDE, não contagem de voltas: cada volta pode gastar três
# `timeout 10` do `lifecycle get` mais o `tf2_echo`, então "180 iterações"
# poderia durar meia hora. O que se promete é 300 s.
PRONTO=0
T0_ESPERA=$(date +%s)
while [ $(( $(date +%s) - T0_ESPERA )) -lt 300 ]; do
  TODOS=1
  for no in $NOS_ATIVOS; do
    estado="$(timeout 10 ros2 lifecycle get "$no" 2>/dev/null | head -1)"
    esta_ativo "$estado" || TODOS=0
  done
  # 🔴 A CAUSA REAL DO TIMEOUT DE 24-09: aqui havia
  # `ros2 action list --spin-time 2`, e este Jazzy NÃO aceita `--spin-time` no
  # `action list` (só `-t` e `-c`): o comando saía com código 2, o `2>/dev/null`
  # engolia a mensagem, a condição nunca passava e o `tf2_echo` jamais rodava.
  # A espera morria de 180 s com o Nav2 ATIVO — o `lifecycle.txt` daquela pasta
  # mostra os três `active [3]`. Erro descartado é erro que mente.
  if [ "$TODOS" -eq 1 ] \
     && timeout 5 ros2 action list 2>>"$SAIDA/action_list.err" \
        | grep -qx '/navigate_to_pose'; then
    # ⚠️ O `tf2_echo` NÃO aceita `--spin-time` e NÃO termina sozinho: quem o
    # encerra é o `timeout`, que sai com 124. Por isso o teste é o CONTEÚDO
    # ("Translation" no arquivo), nunca o código de saída — testar o código
    # aqui daria "nunca pronto" com a TF funcionando.
    timeout 5 ros2 run tf2_ros tf2_echo map base_link > "$SAIDA/tf_inicial.txt" 2>&1
    grep -q 'Translation' "$SAIDA/tf_inicial.txt" && { PRONTO=1; break; }
  fi
  sleep 1
done
echo "   espera: $(( $(date +%s) - T0_ESPERA ))s de parede"
{ echo "estados de ciclo de vida no fim da espera:"
  for no in $NOS_ATIVOS; do
    echo "   $no: $(timeout 10 ros2 lifecycle get "$no" 2>&1 | head -1)"
  done; } > "$SAIDA/lifecycle.txt"
sed 's/^/   /' "$SAIDA/lifecycle.txt"
if [ "$PRONTO" -ne 1 ]; then
  anota "Nav2 active (bt/planner/controller) e TF prontos" REPROVADO \
    "(lifecycle.txt, tf_inicial.txt)"
  echo "   🔴 não ficou pronto — derrubando sem mandar objetivo"; exit 1
fi
anota "Nav2 active (bt/planner/controller) e TF prontos" APROVADO

# ── o relógio SIMULADO, que é o que manda no teto ───────────────────────────
relogio() {   # segundos de tempo simulado, do /clock; vazio se não vier
  timeout 10 ros2 topic echo --once --field clock.sec /clock 2>/dev/null | head -1
}
T0_SIM="$(relogio)"
if [ -z "$T0_SIM" ]; then
  anota "relógio simulado (/clock) respondendo" REPROVADO
  echo "   🔴 sem /clock não dá para aplicar o teto de ${TETO_SIMULADO}s simulados"; exit 1
fi
anota "relógio simulado (/clock) respondendo" APROVADO "t0=${T0_SIM}s"

# ── a pose VIVA, e o objetivo calculado A PARTIR dela ──────────────────────
#
# 🔴 NADA DE COORDENADA ASSUMIDA. A primeira versão mandava `x=1.0 y=0.0`
# porque o `sim_robo3.launch.py` declara `x` e `y` com default 0,0 — mas a
# `pilha.launch.py` passa OUTRA pose de spawn, e o robô nasce em (2,0; 5,0).
# Aquele objetivo não era "1 m à frente": era ~5 m atravessando o mapa, e a
# corrida teria medido outra coisa chamando-a de 1 metro.
#
# Agora: lê pose e orientação vivos do `/Odometry`, e o alvo é
#   goal_x = x + cos(yaw) ; goal_y = y + sin(yaw)
# — 1 m no rumo ATUAL, PRESERVANDO a orientação (o mesmo quatérnio), que é o
# que "1 m à frente na mesma orientação" quer dizer.
echo "== lendo a pose viva para calcular o objetivo =="
POSE_YAML="$(timeout 15 ros2 topic echo --once --field pose.pose /Odometry 2>/dev/null)"
if [ -z "$POSE_YAML" ]; then
  anota "pose inicial lida do /Odometry" REPROVADO "(nenhuma mensagem em 15 s)"
  echo "   🔴 sem pose não dá para calcular objetivo relativo"; exit 1
fi
echo "$POSE_YAML" > "$SAIDA/pose_inicial_bruta.yaml"
CALCULO="$(python3 - "$SAIDA/pose_inicial_bruta.yaml" "$DISTANCIA_DO_OBJETIVO" <<'EOF_PY'
import math, sys, yaml
# 🔴 O `ros2 topic echo --once` deste Jazzy FECHA a mensagem com `---`, que em
# YAML é separador de documento. O arquivo tem, então, um documento com a pose
# e um segundo vazio — e `yaml.safe_load` recusa isso com
# `ComposerError: expected a single document in the stream`. O wrapper abortaria
# ANTES de mandar o objetivo.
#
# `safe_load_all` lê o fluxo inteiro; os documentos vazios (None) caem fora; e
# exige-se EXATAMENTE um sobrando — duas poses aqui significariam que o `--once`
# não foi respeitado, e escolher uma delas em silêncio seria adivinhar qual é a
# pose da corrida.
docs = [d for d in yaml.safe_load_all(open(sys.argv[1])) if d is not None]
if len(docs) != 1:
    sys.exit('esperava 1 documento com a pose, achei %d' % len(docs))
d = docs[0]
dist = float(sys.argv[2])
p, o = d['position'], d['orientation']
# yaw do quatérnio (z-up): a fórmula padrão, sem depender de tf_transformations
yaw = math.atan2(2.0 * (o['w'] * o['z'] + o['x'] * o['y']),
                 1.0 - 2.0 * (o['y'] ** 2 + o['z'] ** 2))
print('%.4f %.4f %.4f %.4f %.6f %.6f %.6f %.6f %.4f'
      % (p['x'], p['y'], p['x'] + dist * math.cos(yaw), p['y'] + dist * math.sin(yaw),
         o['x'], o['y'], o['z'], o['w'], yaw))
EOF_PY
)" || { anota "pose inicial lida do /Odometry" REPROVADO "(quatérnio ilegível)"; exit 1; }
# shellcheck disable=SC2086
set -- $CALCULO
POSE_X="$1"; POSE_Y="$2"; META_X="$3"; META_Y="$4"
Q_X="$5"; Q_Y="$6"; Q_Z="$7"; Q_W="$8"; YAW="$9"
anota "pose inicial lida do /Odometry" ANOTADO "($POSE_X, $POSE_Y) yaw $YAW rad"
anota "objetivo calculado = pose + ${DISTANCIA_DO_OBJETIVO} m no rumo atual" ANOTADO \
  "($META_X, $META_Y), orientação preservada (z=$Q_Z w=$Q_W)"

# ── o objetivo ─────────────────────────────────────────────────────────────
echo "== mandando o objetivo: ($POSE_X, $POSE_Y) -> ($META_X, $META_Y) no frame map =="
registra_cmd "ros2 action send_goal /navigate_to_pose ... x=$META_X y=$META_Y"
setsid ros2 action send_goal --feedback /navigate_to_pose \
  nav2_msgs/action/NavigateToPose \
  "{pose: {header: {frame_id: map}, pose: {position: {x: $META_X, y: $META_Y, z: 0.0}, orientation: {x: $Q_X, y: $Q_Y, z: $Q_Z, w: $Q_W}}}}" \
  > "$SAIDA/objetivo.log" 2>&1 < /dev/null &
PID_GOAL=$!
echo "   send_goal em PID $PID_GOAL — objetivo.log tem o feedback e o resultado"

# ── esperar a ação, SEM sondar tópico ───────────────────────────────────────
#
# 🔴 O QUE ISTO CONSERTA (corrida 20260924_160148): o laço anterior sondava
# `/Odometry` com `ros2 topic echo --once` a cada volta. Cada volta custava até
# 10 s; a navegação inteira durou **3,3 s simulados**. A corrida acabou antes da
# primeira amostra, e o `trajeto.csv` saiu só com o cabeçalho.
#
# Apertar o laço seria remendo: sondagem de fora nunca vai amostrar mais rápido
# do que o nó que já grava tudo. Quem tem a trajetória é o `path_follower`, no
# `seguidor_*.csv` — e o bag tem o resto. Aqui só se ESPERA, pelo relógio
# simulado, e a trajetória se lê depois, do arquivo.
T0_PAREDE=$(date +%s)
TETO_PAREDE=$((TETO_SIMULADO * 6))       # rede de segurança: relógio travado
FIM=""
while :; do
  if ! kill -0 "$PID_GOAL" 2>/dev/null; then FIM="a ação terminou sozinha"; break; fi
  PAREDE=$(( $(date +%s) - T0_PAREDE ))
  if [ "$PAREDE" -ge "$TETO_PAREDE" ]; then
    FIM="WATCHDOG de parede: ${PAREDE}s sem fechar (relógio simulado travado?)"
    kill -INT "$PID_GOAL" 2>/dev/null; break
  fi
  AGORA="$(relogio)"
  if [ -z "$AGORA" ]; then sleep 0.25; continue; fi
  DECORRIDO=$((AGORA - T0_SIM))
  if [ "$DECORRIDO" -ge "$TETO_SIMULADO" ]; then
    FIM="teto de ${TETO_SIMULADO}s simulados (parede: ${PAREDE}s)"
    # Filho direto deste shell e líder do próprio grupo: o sinal não alcança
    # mais ninguém.
    kill -INT "$PID_GOAL" 2>/dev/null
    break
  fi
  sleep 0.25
done
anota "objetivo encerrado" ANOTADO "$FIM"

# ── esperar o send_goal SAIR antes de ler o que ele escreveu ────────────────
#
# 🔴 Sem isto, o `objetivo.log` é lido enquanto o processo ainda está vivo (ou
# acabou de receber o SIGINT) e o buffer dele pode não ter descido para o
# arquivo. O veredito "aceito x rejeitado" sairia de um arquivo pela metade — e
# o pior caso é o silencioso: "não diz aceito nem rejeitado" quando a linha
# existia e só não tinha sido gravada ainda.
for i in $(seq 1 100); do                 # até 10 s
  kill -0 "$PID_GOAL" 2>/dev/null || break
  sleep 0.1
done
if kill -0 "$PID_GOAL" 2>/dev/null; then
  # Ele é filho direto deste shell e líder do próprio grupo: o sinal não
  # alcança mais ninguém.
  kill -TERM "$PID_GOAL" 2>/dev/null; sleep 1
  anota "send_goal encerrado" ANOTADO "(não saiu com INT em 10 s — TERM)"
else
  anota "send_goal encerrado" ANOTADO "(saiu sozinho)"
fi
wait "$PID_GOAL" 2>/dev/null
sync

# ── o goal foi ACEITO ou REJEITADO? ────────────────────────────────────────
# São falhas diferentes e o sintoma é o mesmo (o robô não anda): rejeitado é
# Nav2 recusando o pedido; aceito e sem andar é a cadeia de atuação.
if grep -qi 'Goal accepted' "$SAIDA/objetivo.log"; then
  anota "o objetivo foi ACEITO pelo Nav2" APROVADO
elif grep -qi 'Goal rejected' "$SAIDA/objetivo.log"; then
  anota "o objetivo foi ACEITO pelo Nav2" REPROVADO "(rejeitado — objetivo.log)"
else
  anota "o objetivo foi ACEITO pelo Nav2" ANOTADO \
    "(objetivo.log não diz aceito nem rejeitado)"
fi
RESULTADO_ACAO="$(grep -iE '^Result|status|SUCCEEDED|ABORTED|CANCELED' \
  "$SAIDA/objetivo.log" | tail -3 | paste -sd' | ')"
anota "resultado relatado pela ação" ANOTADO "${RESULTADO_ACAO:-(nada no objetivo.log)}"

# ── a POSE FINAL, medida AGORA e com procedência declarada ─────────────────
#
# ⚠️ Uma leitura só, e depois do fim da ação — não é sondagem. Ela é necessária
# porque o último registro do seguidor acontece ANTES de o robô entrar por
# completo na tolerância: na corrida 20260924_160148 a ação terminou em 38,60 s
# e a placa ainda empurrava até 39,45 s (o `atraso_desliga`). Pose final tirada
# do CSV seria a pose de antes de parar.
POSE_FIM_YAML="$(timeout 15 ros2 topic echo --once --field pose.pose.position /Odometry 2>/dev/null)"
if [ -n "$POSE_FIM_YAML" ]; then
  echo "$POSE_FIM_YAML" > "$SAIDA/pose_final_bruta.yaml"
  FINAL="$(python3 - "$SAIDA/pose_final_bruta.yaml" "$META_X" "$META_Y" <<'EOF_PY'
import math, sys, yaml
docs = [d for d in yaml.safe_load_all(open(sys.argv[1])) if d is not None]
if len(docs) != 1:
    sys.exit('esperava 1 documento com a posição, achei %d' % len(docs))
p = docs[0]
print('%.4f %.4f %.4f' % (p['x'], p['y'],
      math.hypot(p['x'] - float(sys.argv[2]), p['y'] - float(sys.argv[3]))))
EOF_PY
)" && anota "pose final (fonte: /Odometry, uma leitura após o fim)" ANOTADO "$FINAL" \
   || anota "pose final (fonte: /Odometry, uma leitura após o fim)" REPROVADO "(ilegível)"
else
  anota "pose final (fonte: /Odometry, uma leitura após o fim)" REPROVADO \
    "(nenhuma mensagem em 15 s)"
fi

# ── o TRAJETO, lido do CSV do seguidor ─────────────────────────────────────
#
# O `path_follower` grava em disco a cada `log_periodo_s` — 5,0 s vivos
# (`path_follower.py:672,828`). Então, terminada a ação, espera-se UMA gravação
# periódica antes de ler: sem isso as últimas linhas da corrida ainda estão no
# buffer dele, e o trajeto sairia truncado justamente no fim, que é a parte que
# interessa.
PERIODO_SEGUIDOR=5
echo "== esperando a gravação periódica do seguidor (${PERIODO_SEGUIDOR}s + folga) =="
ANTES=$(cat "$SAIDA"/seguidor_*.csv 2>/dev/null | wc -l)
for i in $(seq 1 $(( (PERIODO_SEGUIDOR + 3) * 2 ))); do
  sleep 0.5
  DEPOIS=$(cat "$SAIDA"/seguidor_*.csv 2>/dev/null | wc -l)
  [ "$DEPOIS" -gt "$ANTES" ] && break
done
anota "gravação periódica do seguidor observada" ANOTADO \
  "$ANTES -> $DEPOIS linhas"

# 🔴 EXATAMENTE UM CSV. Dois arquivos aqui significam duas corridas na mesma
# pasta (ou um nó extra), e escolher um em silêncio — o mais novo, o primeiro do
# glob — seria adivinhar de qual corrida é a trajetória que vai para o artigo.
CSVS=("$SAIDA"/seguidor_*.csv)
if [ ! -e "${CSVS[0]}" ]; then
  anota "trajeto (fonte: seguidor_*.csv do path_follower)" REPROVADO \
    "(nenhum seguidor_*.csv na pasta)"
elif [ "${#CSVS[@]}" -ne 1 ]; then
  anota "trajeto (fonte: seguidor_*.csv do path_follower)" REPROVADO \
    "(${#CSVS[@]} arquivos — não escolho um em silêncio)"
else
  TRAJETO="$(python3 - "${CSVS[0]}" "$META_X" "$META_Y" "$SAIDA/trajeto.csv" <<'EOF_PY'
import csv, math, sys
origem, gx, gy, destino = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), sys.argv[4]
linhas = list(csv.DictReader(open(origem)))
if not linhas:
    sys.exit('o seguidor_*.csv não tem linha de dados')
with open(destino, 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(['t_sim', 'x', 'y', 'dist_ao_alvo', 'estado', 'modo', 'v_alvo'])
    perc = 0.0
    ant = None
    for l in linhas:
        x, y = float(l['x']), float(l['y'])
        if ant is not None:
            perc += math.hypot(x - ant[0], y - ant[1])
        ant = (x, y)
        w.writerow([l['t'], '%.4f' % x, '%.4f' % y,
                    '%.4f' % math.hypot(x - gx, y - gy),
                    l['estado'], l['modo'], l['v_alvo']])
p0 = (float(linhas[0]['x']), float(linhas[0]['y']))
print('%d amostras, %ss a %ss, percorrido %.4f m, líquido %.4f m'
      % (len(linhas), linhas[0]['t'], linhas[-1]['t'], perc,
         math.hypot(ant[0] - p0[0], ant[1] - p0[1])))
EOF_PY
)" && anota "trajeto (fonte: seguidor_*.csv do path_follower)" ANOTADO "$TRAJETO" \
   || anota "trajeto (fonte: seguidor_*.csv do path_follower)" REPROVADO "($TRAJETO)"
fi

# ── encerramento DIRIGIDO do gravador, ANTES de o grupo cair ────────────────
# (mesma mecânica medida na etapa 6: SIGTERM no alvo único, janela própria, e só
# depois a limpeza derruba o resto)
python3 "$V/processos.py" foto "$SAIDA/antes_da_limpeza.csv"
fecha_gravador

# A limpeza roda no `trap EXIT` — idempotente, sem pkill, com prova de domínio
# vazio no fim.
echo
echo "== fim da corrida exploratória =="
echo "   pasta: $SAIDA"
echo "   o que olhar: trajeto.csv (distância ao alvo por segundo simulado),"
echo "   objetivo.log (feedback e resultado da ação), tf_inicial/tf_final.txt"
sed 's/^/   /' "$RESULTADO"
