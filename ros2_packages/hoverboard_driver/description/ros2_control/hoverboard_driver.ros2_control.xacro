<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hoverboard_driver_ros2_control" params="name prefix">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>hoverboard_driver/hoverboard_driver</plugin>
        <!-- MEDIDO 2026-07-29: diâmetro 160 mm. Era 0.0825 (roda de 6,5"
             nominal), herdado e nunca medido neste robô. -->
        <param name="wheel_radius">0.080</param>
        <param name="max_velocity">1.0</param>
        <param name="device">/dev/ttyUSB0</param>

        <!-- MEDIDO 2026-07-31, empurrando o robô reto com a mão: a esquerda
             contou +4,681 rad e a direita -4,974. Os dois motores do hoverboard
             são espelhados, então reportam sentidos opostos para o mesmo
             movimento. Sem o sinal por roda a realimentação da direita fica
             invertida em relação ao comando dela, e nenhuma malha fechada é
             possível. -->
        <param name="feedback_sign_left">1.0</param>
        <param name="feedback_sign_right">-1.0</param>

        <!-- ⚠️ Compensação de zona morta do firmware. LIGADA o robô não obedece
             a cmd_vel em magnitude na faixa baixa (o fator de escala cresce
             quando o comando diminui), e nenhum ensaio do tools/banco vale.
             DESLIGADA ele NÃO SAI DO LUGAR na faixa útil — medido em 31-07:
             v=0,25 andou 2 mm em 1,5 s, e v=0,50 ficou 0,9 s plantado antes de
             destravar. A zona morta real do atuador engole toda a faixa de
             operação, então esta compensação não é gambiarra descartável: é
             ela que torna o robô utilizável. Fica LIGADA, e é o sistema COM ela
             que o Gazebo tem de imitar. Ver DIARIO 07-31 4ª leva. -->
        <param name="deadband_enable">true</param>
        <param name="deadband_speed">100.0</param>
      </hardware>
      <joint name="${prefix}left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
