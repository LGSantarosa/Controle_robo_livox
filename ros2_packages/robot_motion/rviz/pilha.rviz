# RViz da bancada do planner.
#
# Duas ferramentas, nesta ordem:
#   "2D Pose Estimate" -> /initialpose : de onde o robô SAIRIA
#   "2D Goal Pose"     -> /goal_pose   : para onde ele iria
#
# Os dois caminhos aparecem juntos, em cores diferentes:
#   VERDE  = Theta*            (o planner do robô 1; supõe girar no lugar)
#   LARANJA = Smac Hybrid-A*   (respeita raio de curva; pode usar ré)
#
# Nada se move: não há robô nesta bancada.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grade
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 24
      Color: 130; 130; 134
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Pista
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.75
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Costmap (com inflação)
      Enabled: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.6
      Color Scheme: costmap
    - Class: rviz_default_plugins/Path
      Name: Plano do Nav2
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 60; 220; 90
      Alpha: 1
      Line Style: Lines
      Pose Style: Arrows
      Arrow Length: 0.12
    # Onde o robô está, do jeito que o Nav2 o enxerga. Só as chaves que a
    # classe Polygon aceita — sobra de propriedade de outro display é como o
    # RViz recusava a configuração INTEIRA e fechava calado (ver o bloco
    # abaixo, mesmo defeito em 28-07).
    - Class: rviz_default_plugins/Polygon
      Name: Robô (footprint)
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 140; 20
      Alpha: 1
    - Class: rviz_default_plugins/Odometry
      Name: Pose (LIO / Gazebo)
      Enabled: true
      Topic:
        Value: /Odometry
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape:
        Value: Arrow
        Color: 40; 200; 255
      Keep: 1
      Covariance:
        Value: false
    # PoseWithCovariance, não Pose: /initialpose é
    # geometry_msgs/PoseWithCovarianceStamped, que é o que a ferramenta
    # "2D Pose Estimate" publica. Com um display do tipo Pose aqui, o RViz
    # via dois tipos no mesmo tópico, recusava a configuração INTEIRA e
    # fechava — a tela ficava vazia sem explicação visível.
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Partida
      Enabled: true
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 40; 200; 255
      Shape: Arrow
      Alpha: 1
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Pose
      Name: Destino
      Enabled: true
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 85; 0
      Shape: Arrow
      Alpha: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Vista de cima
      Scale: 85
      X: 6
      Y: 4
Window Geometry:
  Height: 850
  Width: 1300
  Displays:
    collapsed: false
