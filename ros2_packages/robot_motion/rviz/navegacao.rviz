# RViz para dirigir o robô 2 clicando.
#
# A ferramenta "2D Goal Pose" está apontada para /goal_pose, que é onde o
# goal_navigator escuta. Clicar no chão manda o robô até ali.
#
# `Nuvem Livox` fica vazia no simulador — o robô simulado não tem lidar
# modelado. No robô real ela mostra o que o Mid-360 está vendo, e aí o clique
# passa a ser em cima de coisa de verdade.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grade
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: Robô
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.5
      Show Names: true
    - Class: rviz_default_plugins/Odometry
      Name: Pose (LIO)
      Enabled: true
      Topic:
        Value: /Odometry
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Alpha: 0.7
        Color: 40; 200; 255
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.12
        Head Radius: 0.07
        Value: Arrow
    - Class: rviz_default_plugins/PointCloud2
      Name: Nuvem Livox
      Enabled: true
      Topic:
        Value: /livox/lidar
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color Transformer: AxisColor
      Decay Time: 0
    - Class: rviz_default_plugins/Pose
      Name: Objetivo
      Enabled: true
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 85; 0
      Shape: Arrow
      Alpha: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 1.0
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
